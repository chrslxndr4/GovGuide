---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MoneyGraph from '../../components/graph/MoneyGraph';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;

const { data: official } = await supabase
  .from('officials')
  .select('*, offices(*)')
  .eq('slug', slug)
  .single();

if (!official) return Astro.redirect('/404');

const office = official.offices ?? {};
const stateName: string = office.state ?? '';
const officeName: string = office.title ?? office.name ?? '';

// Transparency score helpers
type TransparencyGrade = 'A' | 'B' | 'C' | 'D' | 'F';

function scoreToGrade(score: number | null | undefined): TransparencyGrade {
  if (score == null) return 'F';
  if (score >= 90) return 'A';
  if (score >= 80) return 'B';
  if (score >= 70) return 'C';
  if (score >= 60) return 'D';
  return 'F';
}

const gradeColorMap: Record<TransparencyGrade, string> = {
  A: 'bg-emerald-100 text-emerald-800 border-emerald-300',
  B: 'bg-lime-100 text-lime-800 border-lime-300',
  C: 'bg-yellow-100 text-yellow-800 border-yellow-300',
  D: 'bg-orange-100 text-orange-800 border-orange-300',
  F: 'bg-red-100 text-red-800 border-red-300',
};

const transparencyGrade = scoreToGrade(official.transparency_score);
const gradeColors = gradeColorMap[transparencyGrade];

// Party helpers
type PartyKey = 'D' | 'R' | 'I' | string;

function partyLabel(party: PartyKey): string {
  const labels: Record<string, string> = {
    D: 'Democrat',
    R: 'Republican',
    I: 'Independent',
  };
  return labels[party] ?? party ?? 'Unknown';
}

function partyColor(party: PartyKey): string {
  if (party === 'D') return 'bg-blue-100 text-blue-800 border-blue-200';
  if (party === 'R') return 'bg-red-100 text-red-800 border-red-200';
  return 'bg-slate-100 text-slate-700 border-slate-200';
}

// Fetch related data in parallel — use type assertions because table schemas
// will be generated via Supabase CLI; these are safe at runtime.
const [
  { data: donors },
  { data: trades },
  { data: votes },
  { data: lobbyingRows },
  { data: conflicts },
  { data: tradeSummary },
] = await Promise.all([
  supabase
    .from('campaign_contributions')
    .select('donor_name, donor_type, amount, cycle')
    .eq('recipient_entity_id', official.entity_id)
    .order('amount', { ascending: false })
    .limit(10),
  supabase
    .from('stock_trades')
    .select('ticker, asset_name, trade_type, trade_date, amount_min, amount_max, disclosed_date')
    .eq('official_entity_id', official.entity_id)
    .order('trade_date', { ascending: false })
    .limit(15),
  supabase
    .from('votes')
    .select('bill_id, bill_title, vote_date, position, donor_aligned')
    .eq('official_entity_id', official.entity_id)
    .order('vote_date', { ascending: false })
    .limit(20),
  supabase
    .from('lobbying_contacts')
    .select('industry, registrant_name, amount, cycle')
    .eq('official_entity_id', official.entity_id)
    .order('amount', { ascending: false })
    .limit(10),
  supabase
    .from('conflict_alerts')
    .select('alert_type, description, severity, severity_score, created_at, source_url')
    .eq('official_entity_id', official.entity_id)
    .eq('status', 'active')
    .in('alert_type', [
      'stock_overlap',
      'donor_conflict',
      'lobbying_conflict',
      'committee_overlap',
      'prediction_insider',
    ])
    .order('created_at', { ascending: false }),
  supabase
    .from('mv_politician_trade_summary')
    .select('*')
    .eq('official_id', official.id)
    .single(),
]);

// Format helpers used in markup
function formatMoney(amount: number | null | undefined): string {
  if (amount == null) return '—';
  if (amount >= 1_000_000) return `$${(amount / 1_000_000).toFixed(1)}M`;
  if (amount >= 1_000) return `$${(amount / 1_000).toFixed(0)}K`;
  return `$${amount.toLocaleString()}`;
}

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

// Flag trades disclosed > 45 days after trade date (STOCK Act threshold)
function isLateDisclosure(tradeDateStr: string | null, disclosedDateStr: string | null): boolean {
  if (!tradeDateStr || !disclosedDateStr) return false;
  const tradeDate = new Date(tradeDateStr);
  const disclosedDate = new Date(disclosedDateStr);
  const diffDays = (disclosedDate.getTime() - tradeDate.getTime()) / (1000 * 60 * 60 * 24);
  return diffDays > 45;
}

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'donors', label: 'Donors' },
  { id: 'stock-trades', label: 'Stock Trades' },
  { id: 'voting-record', label: 'Voting Record' },
  { id: 'lobbying', label: 'Lobbying' },
  { id: 'money-graph', label: 'Money Graph' },
  { id: 'conflicts', label: 'Conflicts' },
];
---

<BaseLayout
  title={official.name}
  description={`Transparency profile for ${official.name} — donors, stock trades, voting record, and conflict alerts.`}
>
  <main class="flex-1">

    <!-- Hero -->
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-5xl mx-auto">
        <Breadcrumb
          items={[
            { label: 'Officials', href: '/officials' },
            { label: official.name },
          ]}
        />

        <div class="flex flex-col sm:flex-row items-start gap-6">

          <!-- Photo placeholder -->
          <div
            class="shrink-0 w-24 h-24 rounded-full bg-[#2a3f6a] border-2 border-white/20
                   flex items-center justify-center text-3xl font-display font-bold text-white/60"
            aria-hidden="true"
          >
            {official.name.charAt(0).toUpperCase()}
          </div>

          <!-- Identity block -->
          <div class="flex-1 min-w-0">
            <h1 class="text-3xl md:text-4xl font-display font-bold mb-2 leading-tight">
              {official.name}
            </h1>

            <div class="flex flex-wrap items-center gap-2 text-sm mb-4">
              {official.party && (
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full border font-medium ${partyColor(official.party)}`}>
                  {partyLabel(official.party)}
                </span>
              )}
              {officeName && (
                <span class="text-slate-300">{officeName}</span>
              )}
              {stateName && (
                <>
                  <span class="text-slate-500" aria-hidden="true">·</span>
                  <span class="text-slate-300">{stateName}</span>
                </>
              )}
            </div>

            <!-- Transparency score badge -->
            <div class="flex items-center gap-3">
              <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">
                Transparency Score
              </span>
              <span
                class={`inline-flex items-center justify-center w-9 h-9 rounded-full border-2 font-display font-bold text-lg ${gradeColors}`}
                title={`Transparency grade: ${transparencyGrade}${official.transparency_score != null ? ` (${official.transparency_score}/100)` : ''}`}
              >
                {transparencyGrade}
              </span>
              {official.transparency_score != null && (
                <span class="text-slate-400 text-sm">{official.transparency_score}/100</span>
              )}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Sticky section nav -->
    <nav
      class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm overflow-x-auto"
      aria-label="Profile sections"
    >
      <div class="max-w-5xl mx-auto px-4">
        <ol class="flex items-center gap-0 text-sm font-medium whitespace-nowrap">
          {sections.map(s => (
            <li>
              <a
                href={`#${s.id}`}
                class="block px-4 py-3 text-civic-slate hover:text-civic-blue border-b-2 border-transparent hover:border-civic-blue transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-10 flex flex-col gap-16">

      <!-- ── Overview ────────────────────────────────────────── -->
      <section id="overview" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Overview
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <!-- Bio -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-2">Biography</h3>
            {official.bio ? (
              <p class="text-slate-700 leading-relaxed text-sm">{official.bio}</p>
            ) : (
              <p class="text-slate-400 text-sm italic">No biography on record.</p>
            )}
          </div>

          <!-- Term & office info -->
          <div class="space-y-4">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-2">Term</h3>
              <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
                <dt class="text-slate-500">Start</dt>
                <dd class="text-slate-800 font-medium">{formatDate(official.term_start)}</dd>
                <dt class="text-slate-500">End</dt>
                <dd class="text-slate-800 font-medium">{formatDate(official.term_end)}</dd>
                {official.district && (
                  <>
                    <dt class="text-slate-500">District</dt>
                    <dd class="text-slate-800 font-medium">{official.district}</dd>
                  </>
                )}
                {official.chamber && (
                  <>
                    <dt class="text-slate-500">Chamber</dt>
                    <dd class="text-slate-800 font-medium">{official.chamber}</dd>
                  </>
                )}
              </dl>
            </div>

            <!-- Transparency score detail -->
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-2">Transparency Score</h3>
              <div class="flex items-center gap-3">
                <span
                  class={`inline-flex items-center justify-center w-12 h-12 rounded-full border-2 font-display font-bold text-2xl ${gradeColors}`}
                >
                  {transparencyGrade}
                </span>
                <div class="text-sm text-slate-600">
                  {official.transparency_score != null ? (
                    <p>{official.transparency_score} out of 100</p>
                  ) : (
                    <p class="italic text-slate-400">Score not yet calculated</p>
                  )}
                </div>
              </div>
            </div>

            <!-- Trade activity summary -->
            {tradeSummary && (tradeSummary.total_trades ?? 0) > 0 && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-2">Trade Activity</h3>
                <div class="grid grid-cols-2 gap-3">
                  <div class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-center">
                    <div class="text-xl font-display font-bold text-civic-navy">{tradeSummary.total_trades}</div>
                    <div class="text-xs text-slate-500 mt-0.5">Total Trades</div>
                  </div>
                  <div class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-center">
                    <div class={`text-xl font-display font-bold ${(tradeSummary.late_filings ?? 0) > 0 ? 'text-red-600' : 'text-civic-navy'}`}>
                      {tradeSummary.late_filings ?? 0}
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">Late Filings</div>
                  </div>
                  <div class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-center">
                    <div class={`text-xl font-display font-bold ${(tradeSummary.committee_overlaps ?? 0) > 0 ? 'text-amber-600' : 'text-civic-navy'}`}>
                      {tradeSummary.committee_overlaps ?? 0}
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">Committee Overlaps</div>
                  </div>
                  <div class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-center">
                    <div class="text-xl font-display font-bold text-civic-navy">{tradeSummary.unique_tickers ?? 0}</div>
                    <div class="text-xs text-slate-500 mt-0.5">Unique Tickers</div>
                  </div>
                </div>
              </div>
            )}
          </div>

        </div>
      </section>

      <!-- ── Donors ──────────────────────────────────────────── -->
      <section id="donors" aria-labelledby="donors-heading">
        <h2 id="donors-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Top Donors
        </h2>

        {donors && donors.length > 0 ? (
          <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                  <th class="px-4 py-3 text-left">Donor</th>
                  <th class="px-4 py-3 text-left">Type</th>
                  <th class="px-4 py-3 text-right">Amount</th>
                  <th class="px-4 py-3 text-right">Cycle</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {donors.map((row, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                    <td class="px-4 py-3 font-medium text-slate-800">{row.donor_name}</td>
                    <td class="px-4 py-3 text-civic-slate capitalize">{row.donor_type ?? '—'}</td>
                    <td class="px-4 py-3 text-right font-mono text-slate-800">{formatMoney(row.amount)}</td>
                    <td class="px-4 py-3 text-right text-slate-500">{row.cycle ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-slate-400 italic text-sm">No donor records on file.</p>
        )}
      </section>

      <!-- ── Stock Trades ─────────────────────────────────────── -->
      <section id="stock-trades" aria-labelledby="stock-trades-heading">
        <h2 id="stock-trades-heading" class="text-xl font-display text-civic-navy mb-2 pb-2 border-b border-slate-200">
          Stock Trades
        </h2>
        <p class="text-xs text-civic-slate mb-6">
          Flags indicate disclosures filed more than 45 days after the trade date, violating the STOCK Act.
        </p>

        {tradeSummary && (tradeSummary.total_trades ?? 0) > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-center">
              <div class="text-2xl font-display font-bold text-civic-navy">{tradeSummary.total_trades}</div>
              <div class="text-xs text-slate-500 mt-0.5">Total Trades</div>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-center">
              <div class={`text-2xl font-display font-bold ${(tradeSummary.late_filings ?? 0) > 0 ? 'text-red-600' : 'text-civic-navy'}`}>
                {tradeSummary.late_filings ?? 0}
              </div>
              <div class="text-xs text-slate-500 mt-0.5">Late Filings</div>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-center">
              <div class={`text-2xl font-display font-bold ${(tradeSummary.committee_overlaps ?? 0) > 0 ? 'text-amber-600' : 'text-civic-navy'}`}>
                {tradeSummary.committee_overlaps ?? 0}
              </div>
              <div class="text-xs text-slate-500 mt-0.5">Committee Overlaps</div>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-center">
              <div class="text-2xl font-display font-bold text-civic-navy">
                {tradeSummary.total_volume != null ? formatMoney(tradeSummary.total_volume) : '—'}
              </div>
              <div class="text-xs text-slate-500 mt-0.5">Total Volume</div>
            </div>
          </div>
        )}

        {trades && trades.length > 0 ? (
          <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                  <th class="px-4 py-3 text-left">Ticker</th>
                  <th class="px-4 py-3 text-left">Asset</th>
                  <th class="px-4 py-3 text-left">Type</th>
                  <th class="px-4 py-3 text-right">Trade Date</th>
                  <th class="px-4 py-3 text-right">Amount</th>
                  <th class="px-4 py-3 text-right">Disclosed</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {trades.map((row, i) => {
                  const late = isLateDisclosure(row.trade_date, row.disclosed_date);
                  return (
                    <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                      <td class="px-4 py-3 font-mono font-medium text-civic-blue">{row.ticker ?? '—'}</td>
                      <td class="px-4 py-3 text-slate-700 max-w-[180px] truncate" title={row.asset_name ?? undefined}>
                        {row.asset_name ?? '—'}
                      </td>
                      <td class="px-4 py-3">
                        <span class={`inline-flex px-2 py-0.5 rounded text-xs font-semibold ${
                          row.trade_type === 'purchase'
                            ? 'bg-emerald-100 text-emerald-700'
                            : row.trade_type === 'sale'
                            ? 'bg-red-100 text-red-700'
                            : 'bg-slate-100 text-slate-600'
                        }`}>
                          {row.trade_type ?? '—'}
                        </span>
                      </td>
                      <td class="px-4 py-3 text-right text-slate-600">{formatDate(row.trade_date)}</td>
                      <td class="px-4 py-3 text-right font-mono text-slate-700">
                        {row.amount_min != null && row.amount_max != null
                          ? `${formatMoney(row.amount_min)} – ${formatMoney(row.amount_max)}`
                          : formatMoney(row.amount_min ?? row.amount_max)}
                      </td>
                      <td class="px-4 py-3 text-right">
                        <span class={late ? 'text-red-600 font-semibold' : 'text-slate-500'}>
                          {formatDate(row.disclosed_date)}
                          {late && (
                            <span
                              class="ml-1 inline-flex items-center"
                              title="Disclosed more than 45 days after trade (STOCK Act violation)"
                              aria-label="Late disclosure"
                            >
                              &#9888;
                            </span>
                          )}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-slate-400 italic text-sm">No stock trade disclosures on file.</p>
        )}
      </section>

      <!-- ── Voting Record ────────────────────────────────────── -->
      <section id="voting-record" aria-labelledby="voting-record-heading">
        <h2 id="voting-record-heading" class="text-xl font-display text-civic-navy mb-2 pb-2 border-b border-slate-200">
          Voting Record
        </h2>
        <p class="text-xs text-civic-slate mb-6">
          Donor alignment indicates whether the vote matched the position of this official's top donor industries.
        </p>

        {votes && votes.length > 0 ? (
          <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                  <th class="px-4 py-3 text-left">Bill</th>
                  <th class="px-4 py-3 text-left">Date</th>
                  <th class="px-4 py-3 text-center">Position</th>
                  <th class="px-4 py-3 text-center">Donor Aligned</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {votes.map((row, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                    <td class="px-4 py-3">
                      <div class="font-medium text-civic-blue">{row.bill_id ?? '—'}</div>
                      {row.bill_title && (
                        <div class="text-xs text-slate-500 mt-0.5 max-w-sm truncate" title={row.bill_title}>
                          {row.bill_title}
                        </div>
                      )}
                    </td>
                    <td class="px-4 py-3 text-slate-600 whitespace-nowrap">{formatDate(row.vote_date)}</td>
                    <td class="px-4 py-3 text-center">
                      <span class={`inline-flex px-2 py-0.5 rounded text-xs font-semibold ${
                        row.position === 'yea' || row.position === 'yes'
                          ? 'bg-emerald-100 text-emerald-700'
                          : row.position === 'nay' || row.position === 'no'
                          ? 'bg-red-100 text-red-700'
                          : 'bg-slate-100 text-slate-600'
                      }`}>
                        {row.position ?? '—'}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-center">
                      {row.donor_aligned === true ? (
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded">
                          <span aria-hidden="true">&#9888;</span> Aligned
                        </span>
                      ) : row.donor_aligned === false ? (
                        <span class="text-xs text-slate-400">No</span>
                      ) : (
                        <span class="text-xs text-slate-300">—</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-slate-400 italic text-sm">No voting record on file.</p>
        )}
      </section>

      <!-- ── Lobbying ─────────────────────────────────────────── -->
      <section id="lobbying" aria-labelledby="lobbying-heading">
        <h2 id="lobbying-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Lobbying
        </h2>

        {lobbyingRows && lobbyingRows.length > 0 ? (
          <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                  <th class="px-4 py-3 text-left">Industry</th>
                  <th class="px-4 py-3 text-left">Registrant</th>
                  <th class="px-4 py-3 text-right">Amount</th>
                  <th class="px-4 py-3 text-right">Cycle</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {lobbyingRows.map((row, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                    <td class="px-4 py-3 font-medium text-slate-800">{row.industry ?? '—'}</td>
                    <td class="px-4 py-3 text-civic-slate">{row.registrant_name ?? '—'}</td>
                    <td class="px-4 py-3 text-right font-mono text-slate-800">{formatMoney(row.amount)}</td>
                    <td class="px-4 py-3 text-right text-slate-500">{row.cycle ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-slate-400 italic text-sm">No lobbying activity on record.</p>
        )}
      </section>

      <!-- ── Money Graph ──────────────────────────────────────── -->
      <section id="money-graph" aria-labelledby="money-graph-heading">
        <h2 id="money-graph-heading" class="text-xl font-display text-civic-navy mb-2 pb-2 border-b border-slate-200">
          Money Graph
        </h2>
        <p class="text-xs text-civic-slate mb-6">
          Interactive network showing financial relationships up to 2 hops from this official.
          Click any node to explore further.
        </p>

        {official.entity_id ? (
          <MoneyGraph
            client:visible
            entityId={official.entity_id}
            hops={2}
            height="400px"
          />
        ) : (
          <div class="rounded-lg border border-slate-200 bg-slate-50 h-48 flex items-center justify-center">
            <p class="text-slate-400 italic text-sm">No entity ID — graph unavailable.</p>
          </div>
        )}
      </section>

      <!-- ── Conflicts ────────────────────────────────────────── -->
      <section id="conflicts" aria-labelledby="conflicts-heading">
        <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-200">
          <h2 id="conflicts-heading" class="text-xl font-display text-civic-navy">
            Active Conflict Alerts
          </h2>
          {official.id && (
            <a
              href={`/conflicts?official_id=${official.id}`}
              class="text-xs text-civic-blue hover:underline font-medium"
            >
              View all conflicts &rarr;
            </a>
          )}
        </div>

        {conflicts && conflicts.length > 0 ? (
          <ul class="flex flex-col gap-4" role="list">
            {conflicts.map(alert => {
              const severityStyles = {
                critical: 'border-red-400 bg-red-50',
                high: 'border-orange-400 bg-orange-50',
                medium: 'border-yellow-400 bg-yellow-50',
                low: 'border-slate-300 bg-white',
              };
              const badgeStyles = {
                critical: 'bg-red-100 text-red-800',
                high: 'bg-orange-100 text-orange-800',
                medium: 'bg-yellow-100 text-yellow-800',
                low: 'bg-slate-100 text-slate-600',
              };
              const severity = alert.severity ?? 'low';
              const cardClass = severityStyles[severity] ?? severityStyles.low;
              const badgeClass = badgeStyles[severity] ?? badgeStyles.low;
              const severityScore = alert.severity_score ?? null;

              return (
                <li class={`rounded-lg border-l-4 p-4 ${cardClass}`} role="listitem">
                  <div class="flex flex-wrap items-start justify-between gap-2 mb-1.5">
                    <span class="font-semibold text-sm text-slate-800 capitalize">
                      {(alert.alert_type ?? 'Alert').replace(/_/g, ' ')}
                    </span>
                    <div class="flex items-center gap-2">
                      {severityScore != null && (
                        <span
                          class={`inline-flex items-center justify-center w-10 h-6 rounded text-xs font-bold tabular-nums border ${badgeClass}`}
                          title="Severity score out of 10"
                        >
                          {severityScore}/10
                        </span>
                      )}
                      <span class={`text-xs font-semibold uppercase px-2 py-0.5 rounded ${badgeClass}`}>
                        {severity}
                      </span>
                      <span class="text-xs text-slate-400">{formatDate(alert.created_at)}</span>
                    </div>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{alert.description}</p>
                  {alert.source_url && (
                    <a
                      href={alert.source_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block mt-2 text-xs text-civic-blue hover:underline"
                    >
                      Source &rarr;
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No active conflict alerts for this official.</p>
        )}
      </section>

    </div>
  </main>
</BaseLayout>
