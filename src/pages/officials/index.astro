---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { supabase } from '../../lib/supabase';

type PartyKey = 'democratic' | 'republican' | 'independent' | 'libertarian' | 'green' | 'other';

interface PartyBreakdown {
  democratic: number;
  republican: number;
  independent: number;
  libertarian: number;
  green: number;
  other: number;
}

interface OfficialRow {
  party: string | null;
}

interface StateRow {
  name: string;
  slug: string;
  state_abbr: string | null;
}

interface FederalOfficialRow {
  id: string;
  full_name: string;
  slug: string;
  party: string | null;
  offices: {
    id: string;
    title: string;
    branch: string;
    chamber: string | null;
  };
}

// Total officials count
const { count: totalCount } = await supabase
  .from('officials')
  .select('id', { count: 'exact', head: true })
  .eq('is_current', true);

// Party breakdown — fetch all current officials' party values
const { data: partyRows } = await supabase
  .from('officials')
  .select('party')
  .eq('is_current', true);

const partyData = (partyRows ?? []) as OfficialRow[];

const partyBreakdown: PartyBreakdown = {
  democratic: 0,
  republican: 0,
  independent: 0,
  libertarian: 0,
  green: 0,
  other: 0,
};

for (const row of partyData) {
  const key = (row.party ?? 'other') as PartyKey;
  if (key in partyBreakdown) {
    partyBreakdown[key]++;
  } else {
    partyBreakdown.other++;
  }
}

// States list for navigation
const { data: statesData } = await supabase
  .from('jurisdictions')
  .select('name, slug, state_abbr')
  .eq('level', 'state')
  .order('name');

const states = (statesData ?? []) as StateRow[];

// Fetch federal jurisdiction
const { data: federalJurisdiction } = await supabase
  .from('jurisdictions')
  .select('id')
  .eq('slug', 'usa')
  .single();

const federalId = federalJurisdiction?.id ?? null;

// Fetch key federal executive offices (President, VP)
const { data: executiveOfficeRows } = await supabase
  .from('offices')
  .select('id, title, branch, chamber')
  .eq('jurisdiction_id', federalId ?? '')
  .eq('branch', 'executive');

const execOfficeIds = executiveOfficeRows?.map((o) => o.id) ?? [];

const { data: keyExecutiveData } = await supabase
  .from('officials')
  .select('id, full_name, slug, party, offices(id, title, branch, chamber)')
  .in('office_id', execOfficeIds.length > 0 ? execOfficeIds : [''])
  .eq('is_current', true)
  .order('last_name');

const keyExecutives = (keyExecutiveData ?? []) as unknown as FederalOfficialRow[];

const president = keyExecutives.find(
  (o) =>
    o.offices?.title?.toLowerCase().includes('president') &&
    !o.offices?.title?.toLowerCase().includes('vice')
);
const vicePresident = keyExecutives.find((o) =>
  o.offices?.title?.toLowerCase().includes('vice president')
);

// Fetch Congress leadership — senators and representatives
const { data: senateOfficeRows } = await supabase
  .from('offices')
  .select('id')
  .eq('jurisdiction_id', federalId ?? '')
  .eq('chamber', 'senate');

const { data: houseOfficeRows } = await supabase
  .from('offices')
  .select('id')
  .eq('jurisdiction_id', federalId ?? '')
  .eq('chamber', 'house');

const senateOfficeIds = senateOfficeRows?.map((o) => o.id) ?? [];
const houseOfficeIds = houseOfficeRows?.map((o) => o.id) ?? [];

const { count: senatorCount } = await supabase
  .from('officials')
  .select('id', { count: 'exact', head: true })
  .in('office_id', senateOfficeIds.length > 0 ? senateOfficeIds : [''])
  .eq('is_current', true);

const { count: repCount } = await supabase
  .from('officials')
  .select('id', { count: 'exact', head: true })
  .in('office_id', houseOfficeIds.length > 0 ? houseOfficeIds : [''])
  .eq('is_current', true);

function formatParty(party: string | null): string {
  if (!party) return 'Unknown';
  return party.charAt(0).toUpperCase() + party.slice(1);
}

function partyBadgeClass(party: string | null): string {
  switch (party) {
    case 'democratic':
      return 'bg-blue-100 text-blue-700';
    case 'republican':
      return 'bg-red-100 text-red-700';
    case 'independent':
      return 'bg-purple-100 text-purple-700';
    case 'libertarian':
      return 'bg-yellow-100 text-yellow-700';
    case 'green':
      return 'bg-green-100 text-green-700';
    default:
      return 'bg-slate-100 text-slate-700';
  }
}
---

<BaseLayout
  title="Officials Directory"
  description="Find elected and appointed officials at every level of government — federal, state, and local."
>
  <Header />
  <main id="main-content" class="flex-1">
    <!-- Hero -->
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-7xl mx-auto">
        <Breadcrumb items={[{ label: 'Officials' }]} />
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-3">
          Officials Directory
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl">
          Every elected and appointed official — from the President of the
          United States to your local city council member. Search by branch,
          state, or level of government.
        </p>
      </div>
    </section>

    <!-- Stats bar -->
    <section class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 py-5">
        <div class="flex flex-wrap gap-6 items-center">
          <div>
            <span class="text-2xl font-display font-bold text-civic-navy">
              {(totalCount ?? 0).toLocaleString()}
            </span>
            <span class="text-sm text-civic-slate ml-2">current officials</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {partyBreakdown.democratic > 0 && (
              <span class="text-sm font-mono px-3 py-1 rounded bg-blue-50 text-blue-700">
                Dem {partyBreakdown.democratic.toLocaleString()}
              </span>
            )}
            {partyBreakdown.republican > 0 && (
              <span class="text-sm font-mono px-3 py-1 rounded bg-red-50 text-red-700">
                Rep {partyBreakdown.republican.toLocaleString()}
              </span>
            )}
            {partyBreakdown.independent > 0 && (
              <span class="text-sm font-mono px-3 py-1 rounded bg-purple-50 text-purple-700">
                Ind {partyBreakdown.independent.toLocaleString()}
              </span>
            )}
            {partyBreakdown.libertarian > 0 && (
              <span class="text-sm font-mono px-3 py-1 rounded bg-yellow-50 text-yellow-700">
                Lib {partyBreakdown.libertarian.toLocaleString()}
              </span>
            )}
            {partyBreakdown.green > 0 && (
              <span class="text-sm font-mono px-3 py-1 rounded bg-green-50 text-green-700">
                Grn {partyBreakdown.green.toLocaleString()}
              </span>
            )}
            {partyBreakdown.other > 0 && (
              <span class="text-sm font-mono px-3 py-1 rounded bg-slate-100 text-slate-700">
                Other {partyBreakdown.other.toLocaleString()}
              </span>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 py-10 space-y-12">
      <!-- Browse by Branch -->
      <section>
        <h2 class="text-2xl font-display text-civic-navy mb-2">Browse by Branch</h2>
        <p class="text-civic-slate text-sm mb-5">
          Navigate officials by the branch of government they serve in at the federal level.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href="/federal/executive"
            class="block p-5 bg-white rounded-lg border border-slate-200 hover:border-civic-blue hover:shadow-md transition-all group"
          >
            <div class="w-9 h-9 rounded bg-civic-navy/10 flex items-center justify-center mb-3">
              <span class="text-civic-navy font-mono text-sm font-bold">E</span>
            </div>
            <h3 class="font-display text-lg text-civic-navy group-hover:text-civic-blue transition-colors">
              Executive Branch
            </h3>
            <p class="text-sm text-civic-slate mt-1">
              President, Vice President, Cabinet secretaries, and federal agencies.
            </p>
          </a>
          <a
            href="/federal/legislative"
            class="block p-5 bg-white rounded-lg border border-slate-200 hover:border-civic-blue hover:shadow-md transition-all group"
          >
            <div class="w-9 h-9 rounded bg-civic-navy/10 flex items-center justify-center mb-3">
              <span class="text-civic-navy font-mono text-sm font-bold">L</span>
            </div>
            <h3 class="font-display text-lg text-civic-navy group-hover:text-civic-blue transition-colors">
              Legislative Branch
            </h3>
            <p class="text-sm text-civic-slate mt-1">
              United States Senate
              {senatorCount != null && senatorCount > 0 ? ` (${senatorCount})` : ' (100 senators)'}
              {' '}and House of Representatives
              {repCount != null && repCount > 0 ? ` (${repCount})` : ' (435 members)'}.
            </p>
          </a>
          <a
            href="/federal/judicial"
            class="block p-5 bg-white rounded-lg border border-slate-200 hover:border-civic-blue hover:shadow-md transition-all group"
          >
            <div class="w-9 h-9 rounded bg-civic-navy/10 flex items-center justify-center mb-3">
              <span class="text-civic-navy font-mono text-sm font-bold">J</span>
            </div>
            <h3 class="font-display text-lg text-civic-navy group-hover:text-civic-blue transition-colors">
              Judicial Branch
            </h3>
            <p class="text-sm text-civic-slate mt-1">
              Supreme Court justices, circuit court judges, and federal judiciary.
            </p>
          </a>
        </div>
      </section>

      <!-- Federal Officials Spotlight -->
      <section>
        <h2 class="text-2xl font-display text-civic-navy mb-2">Federal Officials</h2>
        <p class="text-civic-slate text-sm mb-5">
          Key leadership positions in the United States federal government.
        </p>

        {(president || vicePresident) ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            {president && (
              <a
                href={`/officials/${president.slug}`}
                class="flex items-center gap-4 p-4 bg-white rounded-lg border border-slate-200 hover:border-civic-blue hover:shadow-md transition-all group"
              >
                <div class="w-12 h-12 rounded-full bg-civic-navy flex items-center justify-center text-white font-medium text-sm flex-shrink-0">
                  {president.full_name.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-civic-slate uppercase tracking-wider mb-0.5">
                    President of the United States
                  </p>
                  <p class="font-display text-base text-civic-navy group-hover:text-civic-blue transition-colors truncate">
                    {president.full_name}
                  </p>
                </div>
                {president.party && (
                  <span class={`text-xs font-mono px-2 py-0.5 rounded flex-shrink-0 ${partyBadgeClass(president.party)}`}>
                    {formatParty(president.party)}
                  </span>
                )}
              </a>
            )}
            {vicePresident && (
              <a
                href={`/officials/${vicePresident.slug}`}
                class="flex items-center gap-4 p-4 bg-white rounded-lg border border-slate-200 hover:border-civic-blue hover:shadow-md transition-all group"
              >
                <div class="w-12 h-12 rounded-full bg-civic-navy flex items-center justify-center text-white font-medium text-sm flex-shrink-0">
                  {vicePresident.full_name.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-civic-slate uppercase tracking-wider mb-0.5">
                    Vice President of the United States
                  </p>
                  <p class="font-display text-base text-civic-navy group-hover:text-civic-blue transition-colors truncate">
                    {vicePresident.full_name}
                  </p>
                </div>
                {vicePresident.party && (
                  <span class={`text-xs font-mono px-2 py-0.5 rounded flex-shrink-0 ${partyBadgeClass(vicePresident.party)}`}>
                    {formatParty(vicePresident.party)}
                  </span>
                )}
              </a>
            )}
          </div>
        ) : (
          <p class="text-sm text-civic-slate mb-6">Federal executive data is not yet available.</p>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a
            href="/federal/legislative"
            class="flex items-center justify-between p-4 bg-white rounded-lg border border-slate-200 hover:border-civic-blue transition-all group"
          >
            <div>
              <p class="font-medium text-civic-navy group-hover:text-civic-blue transition-colors">
                U.S. Senate
              </p>
              <p class="text-xs text-civic-slate">
                {senatorCount != null && senatorCount > 0
                  ? `${senatorCount} senators on record`
                  : '100 senators — two per state'}
              </p>
            </div>
            <span class="text-civic-slate text-sm">&rarr;</span>
          </a>
          <a
            href="/federal/legislative"
            class="flex items-center justify-between p-4 bg-white rounded-lg border border-slate-200 hover:border-civic-blue transition-all group"
          >
            <div>
              <p class="font-medium text-civic-navy group-hover:text-civic-blue transition-colors">
                U.S. House of Representatives
              </p>
              <p class="text-xs text-civic-slate">
                {repCount != null && repCount > 0
                  ? `${repCount} representatives on record`
                  : '435 voting members'}
              </p>
            </div>
            <span class="text-civic-slate text-sm">&rarr;</span>
          </a>
        </div>
      </section>

      <!-- Browse by State -->
      <section>
        <h2 class="text-2xl font-display text-civic-navy mb-2">Browse by State</h2>
        <p class="text-civic-slate text-sm mb-5">
          View all current officials for a specific state — governors, state legislators, and more.
        </p>

        {states.length > 0 ? (
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            {states.map((state) => (
              <a
                href={`/states/${state.slug}/officials`}
                class="flex items-center justify-between p-3 bg-white rounded-lg border border-slate-200 hover:border-civic-blue hover:shadow-md transition-all group"
              >
                <span class="font-medium text-civic-navy group-hover:text-civic-blue transition-colors text-sm">
                  {state.name}
                </span>
                {state.state_abbr && (
                  <span class="text-xs font-mono text-civic-slate">{state.state_abbr}</span>
                )}
              </a>
            ))}
          </div>
        ) : (
          <p class="text-sm text-civic-slate">State data is not yet available.</p>
        )}
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
