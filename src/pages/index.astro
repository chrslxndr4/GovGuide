---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GovMap from '../components/map/GovMap';
import AddressSearch from '../components/AddressSearch';
import CategoryCard from '../components/CategoryCard.astro';
---
<BaseLayout title="Home">
  <Header />
  <main id="main-content" class="flex-1">

    <!-- Hero Section -->
    <section class="bg-white border-b border-slate-200 py-16 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-slate-900 mb-4 tracking-tight">
          Know Your Government
        </h1>
        <p class="text-lg text-slate-500 max-w-xl mx-auto mb-8">
          Every official, every dollar, every connection — from the White House to your city hall.
        </p>
        <AddressSearch client:load className="max-w-xl mx-auto" />
      </div>
    </section>

    <!-- Map Section -->
    <section class="bg-[#F9FAFB] border-b border-slate-200 py-10 px-4">
      <div class="max-w-7xl mx-auto">
        <GovMap client:load />
      </div>
    </section>

    <!-- Pillar 1: Navigate Your Government -->
    <section class="bg-white py-14 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="mb-6 pb-4 border-b border-slate-200">
          <h2 class="text-xl font-semibold text-slate-900">Navigate Your Government</h2>
          <p class="text-sm text-slate-500 mt-1">Explore every level of government, find your representatives, and understand the laws that affect you.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <CategoryCard
            title="Federal Government"
            description="Three branches, cabinet departments, agencies, and officials"
            href="/federal"
          />
          <CategoryCard
            title="State Governments"
            description="All 50 states — governors, legislators, agencies, and courts"
            href="/states"
            count={50}
          />
          <CategoryCard
            title="Elections & Voting"
            description="Register to vote, track your ballot, find your candidates"
            href="/elections"
          />
          <CategoryCard
            title="Officials Directory"
            description="Find your elected officials at every level of government"
            href="/officials"
          />
          <CategoryCard
            title="Laws & Legislation"
            description="Federal and state laws, executive orders, and regulations"
            href="/laws"
          />
        </div>
      </div>
    </section>

    <!-- Pillar 2: Follow the Money -->
    <section class="bg-[#F9FAFB] border-y border-slate-200 py-14 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="mb-6 pb-4 border-b border-slate-200">
          <h2 class="text-xl font-semibold text-slate-900">Follow the Money</h2>
          <p class="text-sm text-slate-500 mt-1">Trace campaign contributions, lobbying expenditures, stock trades, and dark money flows through the political system.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <CategoryCard
            title="Money Graph Explorer"
            description="Interactive visualization of money flows between donors, PACs, and officials"
            href="/money/graph"
          />
          <CategoryCard
            title="Lobbying Dashboard"
            description="Who's lobbying whom, on what bills, and how much"
            href="/money/lobbying"
          />
          <CategoryCard
            title="Stock Tracker"
            description="Congressional stock trades and STOCK Act compliance"
            href="/money/stocks"
          />
          <CategoryCard
            title="Dark Money"
            description="501(c)(4) grants, super PAC spending, and dark money chains"
            href="/money/dark-money"
          />
        </div>
      </div>
    </section>

    <!-- Pillar 3: Connect the Dots -->
    <section class="bg-white py-14 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="mb-6 pb-4 border-b border-slate-200">
          <h2 class="text-xl font-semibold text-slate-900">Connect the Dots</h2>
          <p class="text-sm text-slate-500 mt-1">Automated conflict detection, judicial transparency, and prediction market analysis.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <CategoryCard
            title="Conflict Alerts"
            description="Automated detection of donor-vote conflicts, suspicious trades, and revolving doors"
            href="/conflicts"
          />
          <CategoryCard
            title="Judicial Transparency"
            description="Federal judge profiles, financial disclosures, and conflict flags"
            href="/judicial"
          />
          <CategoryCard
            title="Predictions & Markets"
            description="Polling averages, prediction market odds, and anomaly detection"
            href="/predictions"
          />
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
