---
import BaseLayout from '../layouts/BaseLayout.astro';
import PredictionsDashboard from '../components/predictions/PredictionsDashboard';
---

<BaseLayout
  title="Predictions & Markets"
  description="Polling aggregations and prediction market odds for US federal and gubernatorial races. Real-time divergence alerts when markets and polls disagree."
>
  <main class="flex-1 bg-civic-light">

    {/* Hero */}
    <section class="bg-civic-navy text-white py-8 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-start justify-between gap-6 flex-wrap">
          <div>
            <h1 class="text-3xl font-display font-bold mb-2">Predictions &amp; Markets</h1>
            <p class="text-slate-300 max-w-2xl">
              Aggregated polling averages and real-money prediction market odds for US federal
              and gubernatorial races. Divergence alerts flag when markets and polls significantly
              disagree — a potential signal worth watching.
            </p>
          </div>

          {/* What is a prediction market badge */}
          <div class="bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-sm shrink-0 max-w-xs">
            <p class="font-semibold text-white mb-1">Prediction Markets</p>
            <p class="text-slate-300 text-xs leading-relaxed">
              Contracts that pay out based on election outcomes. Prices reflect the crowd's
              implied probability. Sources: Polymarket, Kalshi, Metaculus.
            </p>
          </div>
        </div>

        {/* Quick legend */}
        <div class="mt-5 flex flex-wrap gap-5 text-xs text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-400 inline-block"></span>
            Democratic
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400 inline-block"></span>
            Republican
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-400 inline-block"></span>
            Independent / Other
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-200 border border-red-300 inline-block"></span>
            Divergence alert (&gt;15pp gap)
          </span>
        </div>
      </div>
    </section>

    {/* React island */}
    <div class="max-w-7xl mx-auto px-4 py-8">
      <PredictionsDashboard client:load />
    </div>

  </main>
</BaseLayout>
