---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZipSearch from '../../components/ZipSearch';
import ElectionLookupResults from '../../components/ElectionLookupResults';
import { supabase } from '../../lib/supabase';

const zip = Astro.url.searchParams.get('zip');

interface JurisdictionRef {
  id: string;
  name: string;
  slug: string;
}

interface ZipJurisdictionRow {
  zip_code: string;
  state: JurisdictionRef | null;
  county: JurisdictionRef | null;
  city: JurisdictionRef | null;
}

interface ElectionServices {
  id: string;
  jurisdiction_id: string;
  registration_url: string | null;
  ballot_tracking_url: string | null;
  registration_status_url: string | null;
  election_office_name: string | null;
  election_office_phone: string | null;
  election_office_email: string | null;
  election_office_address: string | null;
  has_online_registration: boolean | null;
  has_ballot_tracking: boolean | null;
  requirements: string | null;
}

interface LookupData {
  zipCode: string;
  jurisdictions: ZipJurisdictionRow[];
  electionServices: ElectionServices | null;
}

let lookupData: LookupData | null = null;
let lookupError: string | null = null;

if (zip) {
  if (!/^\d{5}$/.test(zip)) {
    lookupError = 'Please enter a valid 5-digit ZIP code.';
  } else {
    const { data: zipRows, error: zipError } = await supabase
      .from('zip_jurisdictions')
      .select(`
        zip_code,
        state:state_id(id, name, slug),
        county:county_id(id, name, slug),
        city:city_id(id, name, slug)
      `)
      .eq('zip_code', zip);

    if (zipError) {
      lookupError = 'There was an error looking up this ZIP code. Please try again.';
    } else {
      const jurisdictions = (zipRows ?? []) as ZipJurisdictionRow[];

      // Derive state jurisdiction ID from first result that has a state
      const stateRef = jurisdictions.find((r) => r.state)?.state ?? null;
      let electionServices: ElectionServices | null = null;

      if (stateRef) {
        const { data: services } = await supabase
          .from('election_services')
          .select('*')
          .eq('jurisdiction_id', stateRef.id)
          .maybeSingle();

        electionServices = (services as ElectionServices | null) ?? null;
      }

      lookupData = {
        zipCode: zip,
        jurisdictions,
        electionServices,
      };
    }
  }
}

const pageTitle = zip ? `ZIP ${zip} — Election Lookup` : 'Election Lookup by ZIP Code';
---

<BaseLayout
  title={pageTitle}
  description="Look up upcoming elections, voter registration, and ballot tracking for your ZIP code."
>
  <main id="main-content" class="flex-1">
    <!-- Hero -->
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-7xl mx-auto">
        <Breadcrumb items={[
          { label: 'Elections & Voting', href: '/elections' },
          { label: 'ZIP Code Lookup' },
        ]} />
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-3">
          Election Lookup
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl mb-8">
          Enter your ZIP code to find your elections, voter registration portal,
          ballot tracker, and local election office.
        </p>

        <!-- Search Form -->
        <div class="bg-white/10 backdrop-blur rounded-xl p-6 max-w-lg">
          <p class="text-sm font-medium text-slate-300 mb-3">
            {zip ? `Showing results for ZIP ${zip} — search again below` : 'Enter your 5-digit ZIP code'}
          </p>
          <ZipSearch client:load />
        </div>
      </div>
    </section>

    <!-- Results Area -->
    <section class="max-w-7xl mx-auto px-4 py-10">
      {lookupError && (
        <div class="bg-red-50 border border-red-200 rounded-lg p-5 text-red-700 text-sm">
          {lookupError}
        </div>
      )}

      {!zip && !lookupError && (
        <div class="text-center py-16 text-civic-slate">
          <div class="text-5xl mb-4" aria-hidden="true">&#128205;</div>
          <h2 class="text-xl font-display text-civic-navy mb-2">Enter Your ZIP Code Above</h2>
          <p class="max-w-md mx-auto text-sm">
            We'll show you your jurisdiction information, voter services, and links to
            register, track your ballot, and contact your election office.
          </p>
        </div>
      )}

      {lookupData && (
        <ElectionLookupResults
          client:load
          zipCode={lookupData.zipCode}
          jurisdictions={lookupData.jurisdictions}
          electionServices={lookupData.electionServices}
        />
      )}
    </section>
  </main>
</BaseLayout>
