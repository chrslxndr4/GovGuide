---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;

const { data: county } = await supabase
  .from('jurisdictions')
  .select('*')
  .eq('slug', slug)
  .eq('level', 'county')
  .single();

if (!county) return Astro.redirect('/404');

// Look up the parent state by state_abbr to get its name and slug
const { data: parentState } = await supabase
  .from('jurisdictions')
  .select('name, slug')
  .eq('level', 'state')
  .eq('state_abbr', county.state_abbr)
  .single();

const stateName = parentState?.name ?? null;
const stateSlug = parentState?.slug ?? null;

// Fetch related data in parallel
const [
  { data: officials },
  { data: delegation },
  { data: elections },
  { data: siblingCounties },
  { data: citiesInCounty },
] = await Promise.all([
  supabase
    .from('officials')
    .select('id, full_name, slug, party, photo_url, offices!inner(title, branch, jurisdiction_id)')
    .eq('is_current', true)
    .eq('offices.jurisdiction_id', county.id)
    .order('full_name'),
  supabase
    .from('officials')
    .select('id, full_name, slug, party, photo_url, offices!inner(title, chamber, district, jurisdictions!inner(state_abbr))')
    .eq('is_current', true)
    .eq('offices.jurisdictions.state_abbr', county.state_abbr)
    .in('offices.title', ['U.S. Senator', 'U.S. Representative'])
    .order('full_name')
    .limit(60),
  supabase
    .from('elections')
    .select('id, name, election_date, election_type')
    .eq('jurisdiction_id', county.id)
    .order('election_date', { ascending: false })
    .limit(10),
  supabase
    .from('jurisdictions')
    .select('name, slug, population')
    .eq('level', 'county')
    .eq('state_abbr', county.state_abbr)
    .neq('slug', slug)
    .order('population', { ascending: false })
    .limit(12),
  supabase
    .from('jurisdictions')
    .select('name, slug, population')
    .eq('level', 'city')
    .eq('parent_id', county.id)
    .order('population', { ascending: false })
    .limit(20),
]);

type PartyKey = 'democratic' | 'republican' | 'independent' | 'libertarian' | 'green' | 'other' | string;

function partyLabel(party: PartyKey): string {
  const labels: Record<string, string> = {
    democratic: 'Democrat',
    republican: 'Republican',
    independent: 'Independent',
    libertarian: 'Libertarian',
    green: 'Green',
    other: 'Other',
  };
  return labels[party?.toLowerCase()] ?? party ?? 'Unknown';
}

function partyBadge(party: PartyKey): string {
  const key = party?.toLowerCase();
  if (key === 'democratic') return 'bg-blue-100 text-blue-800 border-blue-200';
  if (key === 'republican') return 'bg-red-100 text-red-800 border-red-200';
  return 'bg-slate-100 text-slate-700 border-slate-200';
}

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

function electionTypeLabel(type: string | null | undefined): string {
  if (!type) return 'General';
  return type.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

const sections = [
  { id: 'officials', label: 'County Officials' },
  { id: 'delegation', label: 'State Delegation' },
  { id: 'spending', label: 'Local Spending' },
  { id: 'elections', label: 'Elections' },
  { id: 'cities', label: 'Cities' },
  { id: 'see-also', label: 'See Also' },
];
---

<BaseLayout
  title={county.name}
  description={`County profile for ${county.name} — officials, state delegation, local spending, and election results.`}
>
  <main class="flex-1">

    <!-- Hero -->
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-5xl mx-auto">
        <Breadcrumb
          items={[
            { label: 'States', href: '/states' },
            ...(stateSlug && stateName ? [{ label: stateName, href: `/states/${stateSlug}` }] : []),
            { label: county.name },
          ]}
        />

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <div
            class="shrink-0 w-20 h-20 rounded-lg bg-[#2a3f6a] border border-white/20
                   flex items-center justify-center text-2xl font-display font-bold text-white/60"
            aria-hidden="true"
          >
            {county.state_abbr ?? '??'}
          </div>

          <div class="flex-1 min-w-0">
            <h1 class="text-3xl md:text-4xl font-display font-bold mb-2 leading-tight">
              {county.name}
            </h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-300">
              {stateName && <span>{stateName}</span>}
              {county.population != null && (
                <>
                  <span class="text-slate-500" aria-hidden="true">·</span>
                  <span>Pop. {county.population.toLocaleString()}</span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky section nav -->
    <nav
      class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm overflow-x-auto"
      aria-label="County sections"
    >
      <div class="max-w-5xl mx-auto px-4">
        <ol class="flex items-center gap-0 text-sm font-medium whitespace-nowrap">
          {sections.map(s => (
            <li>
              <a
                href={`#${s.id}`}
                class="block px-4 py-3 text-civic-slate hover:text-civic-blue border-b-2 border-transparent hover:border-civic-blue transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-10 flex flex-col gap-16">

      <!-- ── County Officials ──────────────────────────────────── -->
      <section id="officials" aria-labelledby="officials-heading">
        <h2 id="officials-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          County Officials
        </h2>

        {officials && officials.length > 0 ? (
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
            {officials.map(official => (
              <li>
                <a
                  href={`/officials/${official.slug}`}
                  class="flex items-center gap-3 p-4 rounded-lg border border-slate-200 bg-white hover:border-civic-blue hover:shadow-sm transition-all"
                >
                  <div
                    class="shrink-0 w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center
                           text-sm font-display font-bold text-slate-500"
                    aria-hidden="true"
                  >
                    {official.full_name.charAt(0).toUpperCase()}
                  </div>
                  <div class="min-w-0">
                    <div class="font-semibold text-slate-800 truncate">{official.full_name}</div>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-xs text-civic-slate truncate">
                        {Array.isArray(official.offices) && official.offices[0]?.title
                          ? official.offices[0].title
                          : 'Official'}
                      </span>
                      {official.party && (
                        <span class={`inline-flex px-1.5 py-0.5 rounded text-xs font-semibold border ${partyBadge(official.party)}`}>
                          {partyLabel(official.party)}
                        </span>
                      )}
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No officials on record for this county.</p>
        )}
      </section>

      <!-- ── State Delegation ──────────────────────────────────── -->
      <section id="delegation" aria-labelledby="delegation-heading">
        <h2 id="delegation-heading" class="text-xl font-display text-civic-navy mb-2 pb-2 border-b border-slate-200">
          State Delegation
        </h2>
        <p class="text-xs text-civic-slate mb-6">
          Federal legislators representing {stateName ?? 'this state'} in Congress.
        </p>

        {delegation && delegation.length > 0 ? (
          <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                  <th class="px-4 py-3 text-left">Name</th>
                  <th class="px-4 py-3 text-left">Chamber</th>
                  <th class="px-4 py-3 text-left">Party</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {delegation.map((official, i) => {
                  const office = Array.isArray(official.offices) ? official.offices[0] : null;
                  return (
                    <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                      <td class="px-4 py-3">
                        <a href={`/officials/${official.slug}`} class="font-medium text-civic-blue hover:underline">
                          {official.full_name}
                        </a>
                      </td>
                      <td class="px-4 py-3 text-civic-slate capitalize">{office?.chamber ?? '—'}</td>
                      <td class="px-4 py-3">
                        {official.party ? (
                          <span class={`inline-flex px-2 py-0.5 rounded text-xs font-semibold border ${partyBadge(official.party)}`}>
                            {partyLabel(official.party)}
                          </span>
                        ) : '—'}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-slate-400 italic text-sm">No delegation data on record.</p>
        )}
      </section>

      <!-- ── Local Spending ────────────────────────────────────── -->
      <section id="spending" aria-labelledby="spending-heading">
        <h2 id="spending-heading" class="text-xl font-display text-civic-navy mb-2 pb-2 border-b border-slate-200">
          Local Spending
        </h2>
        <p class="text-xs text-civic-slate mb-6">
          Budget and expenditure data for {county.name}. Sourced from county financial disclosures.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {[
            { label: 'Annual Budget' },
            { label: 'Per Capita Spending' },
            { label: 'Fiscal Year' },
          ].map(stat => (
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <div class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-1">
                {stat.label}
              </div>
              <div class="text-2xl font-display font-bold text-civic-navy">
                <span class="text-slate-300 text-base font-normal italic">Not available</span>
              </div>
            </div>
          ))}
        </div>

        {county.website && (
          <div class="mt-4">
            <a
              href={county.website}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-civic-blue hover:underline"
            >
              Visit county website &rarr;
            </a>
          </div>
        )}
      </section>

      <!-- ── Elections ─────────────────────────────────────────── -->
      <section id="elections" aria-labelledby="elections-heading">
        <h2 id="elections-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Elections
        </h2>

        {elections && elections.length > 0 ? (
          <ul class="flex flex-col gap-3" role="list">
            {elections.map(election => (
              <li class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-4 rounded-lg border border-slate-200 bg-white">
                <div>
                  <div class="font-semibold text-slate-800">{election.name}</div>
                  <div class="text-xs text-civic-slate mt-0.5">{electionTypeLabel(election.election_type)}</div>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="text-sm text-slate-500">{formatDate(election.election_date)}</span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No election records for this county.</p>
        )}
      </section>

      <!-- ── Cities in this County ─────────────────────────────── -->
      <section id="cities" aria-labelledby="cities-heading">
        <h2 id="cities-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Cities in {county.name}
        </h2>

        {citiesInCounty && citiesInCounty.length > 0 ? (
          <ul
            class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-1"
            role="list"
          >
            {citiesInCounty.map(city => (
              <li class="flex items-baseline gap-1 min-w-0">
                <a
                  href={`/cities/${city.slug}`}
                  class="text-sm text-blue-600 hover:underline no-underline truncate"
                >
                  {city.name}
                </a>
                {city.population != null && (
                  <span class="text-xs text-slate-400 ml-1 shrink-0">
                    (pop.&nbsp;{city.population.toLocaleString()})
                  </span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No city data available for this county.</p>
        )}
      </section>

      <!-- ── Other Counties in State ────────────────────────────── -->
      <section id="see-also" aria-labelledby="see-also-heading">
        <h2 id="see-also-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Other Counties in {stateName ?? county.state_abbr}
        </h2>

        {siblingCounties && siblingCounties.length > 0 ? (
          <>
            <ul
              class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-1"
              role="list"
            >
              {siblingCounties.map(sibling => (
                <li class="flex items-baseline gap-1 min-w-0">
                  <a
                    href={`/counties/${sibling.slug}`}
                    class="text-sm text-blue-600 hover:underline no-underline truncate"
                  >
                    {sibling.name}
                  </a>
                  {sibling.population != null && (
                    <span class="text-xs text-slate-400 ml-1 shrink-0">
                      (pop.&nbsp;{sibling.population.toLocaleString()})
                    </span>
                  )}
                </li>
              ))}
            </ul>
            {stateSlug && stateName && (
              <a
                href={`/states/${stateSlug}#counties`}
                class="text-sm text-blue-600 hover:underline font-medium mt-3 inline-block"
              >
                View all counties in {stateName} &rarr;
              </a>
            )}
          </>
        ) : (
          <p class="text-slate-400 italic text-sm">No sibling county data available.</p>
        )}
      </section>

    </div>
  </main>
</BaseLayout>
