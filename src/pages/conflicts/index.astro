---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConflictFeed from '../../components/alerts/ConflictFeed';
import DisclaimerBanner from '../../components/conflicts/DisclaimerBanner';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { count: totalAlerts } = await supabase
  .from('conflict_alerts')
  .select('*', { count: 'exact', head: true });

const { count: criticalAlerts } = await supabase
  .from('conflict_alerts')
  .select('*', { count: 'exact', head: true })
  .gte('severity_score', 8);

const { count: activeAlerts } = await supabase
  .from('conflict_alerts')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'active');

const { count: predictionAlerts } = await supabase
  .from('conflict_alerts')
  .select('*', { count: 'exact', head: true })
  .eq('alert_type', 'prediction_insider');

const { count: stockAlerts } = await supabase
  .from('conflict_alerts')
  .select('*', { count: 'exact', head: true })
  .in('alert_type', ['stock_committee', 'trade_timing']);

const { data: initialAlerts } = await supabase
  .from('conflict_alerts')
  .select('*')
  .eq('status', 'active')
  .order('severity_score', { ascending: false })
  .limit(20);
---
<BaseLayout title="Conflict Alerts">
  <Header />
  <main id="main-content" class="flex-1 bg-surface-50">

    <!-- Hero -->
    <section class="bg-white border-b border-border px-4 py-10">
      <div class="max-w-7xl mx-auto">
        <p class="text-xs font-medium text-civic-blue uppercase tracking-widest mb-2">GovGuide / Conflicts</p>
        <h1 class="text-3xl md:text-4xl font-display font-bold text-civic-navy mb-2">Conflict of Interest Alerts</h1>
        <p class="text-sm text-muted max-w-2xl">
          Automated detection of potential conflicts — donor-vote alignment, suspicious stock trades,
          judicial financial conflicts, and revolving door patterns.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 py-8">

      <!-- Stat cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
        <div class="bg-white border border-border rounded-card px-5 py-4">
          <p class="text-2xl font-bold font-mono tabular-nums text-civic-navy leading-none mb-1">
            {(totalAlerts ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Total Alerts</p>
        </div>
        <!-- Critical card: red top border accent -->
        <div class="bg-white border border-border rounded-card px-5 py-4 border-t-2 border-t-red-500">
          <p class="text-2xl font-bold font-mono tabular-nums text-civic-red leading-none mb-1">
            {(criticalAlerts ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Critical Severity</p>
        </div>
        <div class="bg-white border border-border rounded-card px-5 py-4">
          <p class="text-2xl font-bold font-mono tabular-nums text-warning leading-none mb-1">
            {(activeAlerts ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Active Alerts</p>
        </div>
        <!-- Prediction anomaly card: pink top border accent -->
        <div class="bg-white border border-border rounded-card px-5 py-4 border-t-2 border-t-pink-500">
          <p class="text-2xl font-bold font-mono tabular-nums text-pink-600 leading-none mb-1">
            {(predictionAlerts ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Prediction Anomalies</p>
        </div>
        <!-- Stock conflicts card: amber top border accent -->
        <div class="bg-white border border-border rounded-card px-5 py-4 border-t-2 border-t-amber-400">
          <p class="text-2xl font-bold font-mono tabular-nums text-amber-600 leading-none mb-1">
            {(stockAlerts ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Stock Conflicts</p>
        </div>
      </div>

      <!-- Toolbar row -->
      <div class="flex items-center justify-between mb-5">
        <div class="flex items-center gap-3">
          <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Active Alerts</h2>
          <div class="h-px w-24 bg-border"></div>
        </div>
        <a
          href="/api/alerts/feed?format=rss"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-civic-blue hover:text-civic-blue-hover border border-border hover:border-civic-blue rounded px-3 py-1.5 transition-colors duration-fast"
        >
          <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <circle cx="2.5" cy="13.5" r="1.5"/>
            <path d="M1 7.5a7 7 0 0 1 7 7M1 3a11 11 0 0 1 11 11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          RSS Feed
        </a>
      </div>

      <ConflictFeed
        client:load
        initialAlerts={initialAlerts ?? []}
        apiEndpoint="/api/conflicts"
      />

      <div class="mt-8">
        <DisclaimerBanner client:load />
      </div>

    </section>
  </main>
  <Footer />
</BaseLayout>
