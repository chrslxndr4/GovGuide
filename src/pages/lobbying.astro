---
import BaseLayout from '../layouts/BaseLayout.astro';
import LobbyingDashboard from '../components/lobbying/LobbyingDashboard';
---

<BaseLayout
  title="Lobbying Dashboard"
  description="Track lobbying registrations, spending, and influence across Congress and federal agencies via Lobbying Disclosure Act filings."
>
  <main class="flex-1 bg-civic-light">

    {/* Hero */}
    <section class="bg-civic-navy text-white py-8 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-start justify-between gap-6 flex-wrap">
          <div>
            <h1 class="text-3xl font-display font-bold mb-2">Lobbying Dashboard</h1>
            <p class="text-slate-300 max-w-2xl">
              Track lobbying registrations, spending, and influence across Congress and federal agencies.
              Data is drawn from
              <abbr title="Lobbying Disclosure Act">LDA</abbr> filings submitted to the Senate Office of Public Records.
            </p>
          </div>

          {/* LDA summary badge */}
          <div class="bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-sm shrink-0">
            <p class="font-semibold text-white mb-0.5">Lobbying Disclosure Act</p>
            <p class="text-slate-300 text-xs leading-relaxed">
              Firms must register when lobbying<br />
              contacts exceed <strong class="text-white">$3,000 / quarter</strong>.<br />
              Reports filed quarterly.
            </p>
          </div>
        </div>

        {/* Quick legend */}
        <div class="mt-5 flex flex-wrap gap-6 text-xs text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-civic-blue inline-block"></span>
            Lobbying firm (registrant)
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-400 inline-block"></span>
            Client (entity paying for lobbying)
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-300 inline-block"></span>
            Issue area (general issue code)
          </span>
        </div>
      </div>
    </section>

    {/* React island */}
    <div class="max-w-7xl mx-auto px-4 py-8">
      <LobbyingDashboard client:load />
    </div>

  </main>
</BaseLayout>
