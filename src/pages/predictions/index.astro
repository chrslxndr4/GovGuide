---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { data: latestPolls } = await supabase
  .from('polls')
  .select('*')
  .order('date_conducted', { ascending: false })
  .limit(20);

const { data: activeContracts } = await supabase
  .from('prediction_contracts')
  .select('*')
  .eq('resolved', false)
  .order('volume_total', { ascending: false, nullsFirst: false })
  .limit(20);

const contractsByCategory: Record<string, typeof activeContracts> = {};
for (const contract of activeContracts ?? []) {
  const cat = contract.category ?? 'other';
  if (!contractsByCategory[cat]) contractsByCategory[cat] = [];
  contractsByCategory[cat]!.push(contract);
}

const { data: anomalies } = await supabase
  .from('prediction_anomalies')
  .select('*, contract:contract_id(question, platform)')
  .order('severity_score', { ascending: false })
  .limit(5);

const { data: topPollsters } = await supabase
  .from('pollster_ratings')
  .select('*')
  .order('accuracy_score', { ascending: false })
  .limit(10);

function formatProbability(p: number | null): string {
  if (p === null) return '—';
  return `${(p * 100).toFixed(1)}%`;
}

function formatVolume(v: number | null): string {
  if (!v) return '—';
  if (v >= 1e6) return `$${(v / 1e6).toFixed(1)}M`;
  if (v >= 1e3) return `$${(v / 1e3).toFixed(0)}K`;
  return `$${v}`;
}
---
<BaseLayout title="Predictions & Markets">
  <Header />
  <main id="main-content" class="flex-1">
    <section class="bg-civic-navy text-white py-12 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl font-display font-bold mb-4">Predictions & Markets</h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto">
          Polling averages, prediction market odds, and anomaly detection —
          where data meets democracy.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <!-- Prediction Markets -->
          <div>
            <h2 class="text-2xl font-display text-civic-navy mb-4">Prediction Markets</h2>
            {Object.keys(contractsByCategory).length === 0 ? (
              <p class="text-civic-slate italic">No active prediction contracts. Data will appear as import pipelines run.</p>
            ) : (
              Object.entries(contractsByCategory).map(([category, contracts]) => (
                <div class="mb-6">
                  <h3 class="text-lg font-semibold text-civic-slate capitalize mb-3">{category}</h3>
                  <div class="space-y-3">
                    {(contracts ?? []).map((c) => (
                      <div class="bg-white rounded-lg shadow p-4">
                        <div class="flex justify-between items-start mb-2">
                          <p class="font-medium text-civic-navy flex-1 mr-4">{c.question}</p>
                          <span class="text-xs px-2 py-1 bg-slate-100 text-civic-slate rounded">{c.platform}</span>
                        </div>
                        <div class="flex items-center gap-4">
                          <div class="flex-1 bg-slate-200 rounded-full h-4 overflow-hidden">
                            <div
                              class="h-full bg-civic-blue rounded-full transition-all"
                              style={`width: ${(c.current_probability ?? 0) * 100}%`}
                            ></div>
                          </div>
                          <span class="text-lg font-bold text-civic-navy min-w-[4rem] text-right">
                            {formatProbability(c.current_probability)}
                          </span>
                          <span class="text-xs text-civic-slate">{formatVolume(c.volume_total)} vol</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            )}
          </div>

          <!-- Latest Polls -->
          <div>
            <h2 class="text-2xl font-display text-civic-navy mb-4">Latest Polls</h2>
            {(latestPolls ?? []).length === 0 ? (
              <p class="text-civic-slate italic">No polling data yet.</p>
            ) : (
              <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="w-full text-sm">
                  <thead class="bg-slate-50">
                    <tr>
                      <th class="px-4 py-3 text-left text-civic-navy font-semibold">Pollster</th>
                      <th class="px-4 py-3 text-left text-civic-navy font-semibold">Race</th>
                      <th class="px-4 py-3 text-left text-civic-navy font-semibold">Results</th>
                      <th class="px-4 py-3 text-left text-civic-navy font-semibold">Date</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {(latestPolls ?? []).map((poll) => {
                      const candidates = poll.candidates as Record<string, number> | null;
                      const results = candidates ? Object.entries(candidates).map(([n, v]) => `${n}: ${v}%`).join(', ') : '—';
                      return (
                        <tr class="hover:bg-slate-50">
                          <td class="px-4 py-3 font-medium">{poll.pollster}</td>
                          <td class="px-4 py-3">{poll.race_type} ({poll.geography ?? 'National'})</td>
                          <td class="px-4 py-3 text-xs">{results}</td>
                          <td class="px-4 py-3">{poll.date_conducted ?? '—'}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </div>

          <div id="poll-chart-mount" data-race="presidential"></div>
          <div id="prediction-chart-mount"></div>
        </div>

        <div class="space-y-6">
          <!-- Anomaly Alerts -->
          <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-display text-civic-navy mb-3">Market Anomalies</h2>
            {(anomalies ?? []).length === 0 ? (
              <p class="text-green-600 text-sm">No anomalies detected</p>
            ) : (
              <div class="space-y-3">
                {(anomalies ?? []).map((a) => {
                  const contract = a.contract as { question?: string; platform?: string } | null;
                  return (
                    <div class="border-l-4 border-civic-gold pl-3 py-2">
                      <p class="text-sm font-medium capitalize">{a.anomaly_type?.replace('_', ' ')}</p>
                      <p class="text-xs text-civic-slate">{contract?.question?.substring(0, 60) ?? 'Unknown contract'}...</p>
                      <p class="text-xs text-civic-slate">Severity: {a.severity_score}/10</p>
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          <!-- Top Pollsters -->
          <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-display text-civic-navy mb-3">Most Accurate Pollsters</h2>
            {(topPollsters ?? []).length === 0 ? (
              <p class="text-civic-slate italic text-sm">No pollster ratings yet.</p>
            ) : (
              <div class="space-y-2">
                {(topPollsters ?? []).map((p, i) => (
                  <div class="flex justify-between text-sm">
                    <span>{i + 1}. {p.pollster}</span>
                    <span class="font-mono text-civic-blue">{p.accuracy_score?.toFixed(2) ?? '—'}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
