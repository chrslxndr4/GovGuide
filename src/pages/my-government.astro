---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MyGovernmentResults from '../components/MyGovernmentResults';

export const prerender = false;

const addressParam = Astro.url.searchParams.get('address') ?? '';
// Also support legacy zip param — redirect to address-based
const zipParam = Astro.url.searchParams.get('zip') ?? '';
const initialAddress = addressParam || (zipParam ? zipParam : '');
---
<BaseLayout
  title="My Government"
  description="Find every official who represents you — from the President to your city council. Enter your address to see all your representatives, their donors, and potential conflicts."
>
  <Header />
  <main id="main-content" class="flex-1 bg-white">

    <!-- Hero -->
    <section class="bg-white border-b border-slate-200 py-10 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-medium text-civic-blue uppercase tracking-widest mb-2">Personalized Civic Dashboard</p>
        <h1 class="text-3xl md:text-4xl font-display font-bold text-slate-900 mb-3">
          My Government
        </h1>
        <p class="text-sm text-slate-500 max-w-xl mx-auto mb-6">
          Enter your address to see every official who represents you — President, Senators,
          House Rep, Governor, state legislators, county and city officials — plus their donors
          and potential conflicts of interest.
        </p>

        <!-- Address search form -->
        <form
          method="get"
          action="/my-government"
          class="relative max-w-xl mx-auto"
          id="hero-address-form"
        >
          <div class="flex gap-2">
            <input
              type="text"
              name="address"
              value={initialAddress}
              placeholder="Enter your full address (e.g. 1600 Pennsylvania Ave NW, Washington, DC 20500)"
              required
              minlength="5"
              class="flex-1 px-4 py-3 rounded-lg border border-slate-200 text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              aria-label="Street address"
              id="hero-address-input"
            />
            <button
              type="submit"
              class="px-5 py-3 bg-civic-blue text-white font-medium rounded-lg hover:bg-blue-700 transition-colors text-sm whitespace-nowrap"
            >
              Find My Reps
            </button>
          </div>
        </form>

        {initialAddress && (
          <p class="text-slate-400 text-xs mt-3">
            Showing results for <strong class="text-slate-600">{initialAddress}</strong>
          </p>
        )}
      </div>
    </section>

    <!-- Results area — React island handles fetch + render -->
    <section class="max-w-7xl mx-auto px-4 py-10">
      <MyGovernmentResults initialAddress={initialAddress} client:load />
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  // Progressive enhancement: intercept form submit to avoid full reload
  const form = document.getElementById('hero-address-form') as HTMLFormElement | null;
  const input = document.getElementById('hero-address-input') as HTMLInputElement | null;

  if (form && input) {
    form.addEventListener('submit', (e: Event) => {
      const address = input.value.trim();
      if (address.length < 5) return;
      e.preventDefault();
      const url = new URL(window.location.href);
      url.searchParams.set('address', address);
      url.searchParams.delete('zip');
      window.history.pushState(null, '', url.toString());
      window.dispatchEvent(new CustomEvent('govguide:address-search', { detail: { address } }));
    });
  }
</script>
