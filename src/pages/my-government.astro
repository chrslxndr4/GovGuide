---
import BaseLayout from '../layouts/BaseLayout.astro';
import MyGovernmentResults from '../components/MyGovernmentResults';

// Read an optional ?zip= query param so the page can be linked directly
// (e.g. from the homepage ZipSearch which navigates to /elections/lookup —
// this param-driven approach also enables any future cross-links).
const zipParam = Astro.url.searchParams.get('zip') ?? '';
const initialZip = /^\d{5}$/.test(zipParam) ? zipParam : '';
---

<BaseLayout
  title="My Government"
  description="Find your elected officials, local donors, conflict alerts, upcoming elections, and spending data for your ZIP code."
>
  <main class="flex-1">

    <!-- Hero -->
    <section class="bg-civic-navy text-white py-12 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-300 mb-3">
          Personalized Civic Dashboard
        </p>
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">
          My Government
        </h1>
        <p class="text-slate-300 text-lg max-w-xl mx-auto mb-8">
          Enter your ZIP code to see every official who represents you, who funds them,
          potential conflicts of interest, upcoming elections, and where local money is spent.
        </p>

        <!-- Inline ZIP form — submits to this page with ?zip= so the React
             island can pick it up via initialZip, and JS-disabled users still
             get a meaningful URL. -->
        <form
          method="get"
          action="/my-government"
          class="relative max-w-md mx-auto"
          id="hero-zip-form"
        >
          <div class="flex gap-2">
            <input
              type="text"
              name="zip"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
              value={initialZip}
              placeholder="Enter your ZIP code"
              required
              class="flex-1 px-4 py-3 rounded-lg border border-slate-600 bg-white/10 text-white placeholder-slate-400 text-lg font-mono focus:outline-none focus:ring-2 focus:ring-civic-blue focus:border-transparent"
              aria-label="ZIP code"
              id="hero-zip-input"
            />
            <button
              type="submit"
              class="px-6 py-3 bg-civic-blue text-white font-medium rounded-lg hover:bg-blue-500 transition-colors"
            >
              Search
            </button>
          </div>
        </form>

        {initialZip && (
          <p class="text-blue-200 text-sm mt-3 font-mono">
            Showing data for ZIP <strong>{initialZip}</strong>
          </p>
        )}
      </div>
    </section>

    <!-- Civic data pillars strip -->
    <section class="bg-white border-b border-slate-200" aria-hidden="true">
      <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap gap-x-8 gap-y-2 justify-center">
        {[
          'Your Officials',
          'Top Donors',
          'Active Alerts',
          'Upcoming Elections',
          'Local Spending',
        ].map((label) => (
          <span class="text-xs font-semibold text-civic-slate uppercase tracking-widest">
            {label}
          </span>
        ))}
      </div>
    </section>

    <!-- Results area — React island handles fetch + render -->
    <section class="max-w-7xl mx-auto px-4 py-10">
      <MyGovernmentResults initialZip={initialZip} client:load />
    </section>

    <!-- About strip -->
    <aside class="bg-slate-50 border-t border-slate-200 mt-4">
      <div class="max-w-3xl mx-auto px-4 py-8 text-center">
        <h2 class="font-display text-lg text-civic-navy mb-2">How this works</h2>
        <p class="text-sm text-civic-slate leading-relaxed">
          GovGuide maps your ZIP code to state, county, and municipal jurisdictions, then pulls
          officials, campaign finance records, conflict-of-interest disclosures, election
          schedules, and public spending data from official government APIs and public records.
          All data is free, unaffiliated, and updated regularly.
        </p>
        <div class="flex flex-wrap justify-center gap-4 mt-4">
          <a href="/money/graph" class="text-sm text-civic-blue hover:underline">
            Follow the Money Graph
          </a>
          <a href="/connect/conflicts" class="text-sm text-civic-blue hover:underline">
            Conflict of Interest Tracker
          </a>
          <a href="/elections" class="text-sm text-civic-blue hover:underline">
            Elections &amp; Voting
          </a>
          <a href="/officials" class="text-sm text-civic-blue hover:underline">
            Officials Directory
          </a>
        </div>
      </div>
    </aside>

  </main>
</BaseLayout>

<script>
  // Progressive enhancement: intercept the hero form submit client-side so
  // the page does not do a hard reload when JS is available. Instead, update
  // the URL param and let the React island handle the data fetch.
  const form = document.getElementById('hero-zip-form') as HTMLFormElement | null;
  const input = document.getElementById('hero-zip-input') as HTMLInputElement | null;

  if (form && input) {
    form.addEventListener('submit', (e: Event) => {
      const zip = input.value.trim();
      if (!/^\d{5}$/.test(zip)) return; // let native validation handle it
      e.preventDefault();
      const url = new URL(window.location.href);
      url.searchParams.set('zip', zip);
      // Update the URL visibly so the link is shareable, but avoid a reload.
      window.history.pushState(null, '', url.toString());
      // Dispatch a custom event that MyGovernmentResults listens for.
      window.dispatchEvent(new CustomEvent('govguide:zip-search', { detail: { zip } }));
    });
  }
</script>
