---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import JurisdictionLayout from '../../../components/JurisdictionLayout.astro';
import { supabase } from '../../../lib/supabase';

const { slug } = Astro.params;

const { data: state } = await supabase
  .from('jurisdictions')
  .select('*')
  .eq('slug', slug)
  .eq('level', 'state')
  .single();

if (!state) return Astro.redirect('/404');

// State officials: join through offices to filter by jurisdiction
const { data: officials } = await supabase
  .from('officials')
  .select('id, full_name, slug, party, photo_url, term_start, term_end, offices!inner(id, title, branch, chamber, district)')
  .eq('is_current', true)
  .eq('offices.jurisdiction_id', state.id)
  .limit(50);

// Parallel fetches for congressional delegation, bills, upcoming elections, counties, and cities
const [
  { data: senators },
  { data: houseReps },
  { data: recentBills },
  { data: upcomingElections },
  { data: counties },
  { data: cities },
] = await Promise.all([
  supabase
    .from('officials')
    .select('id, full_name, slug, party, photo_url, term_start, term_end, offices!inner(title, chamber, district, jurisdictions!inner(state_abbr))')
    .eq('is_current', true)
    .eq('offices.title', 'U.S. Senator')
    .eq('offices.jurisdictions.state_abbr', state.state_abbr)
    .order('full_name')
    .limit(2),
  supabase
    .from('officials')
    .select('id, full_name, slug, party, photo_url, term_start, term_end, offices!inner(title, chamber, district, jurisdictions!inner(state_abbr))')
    .eq('is_current', true)
    .eq('offices.title', 'U.S. Representative')
    .eq('offices.jurisdictions.state_abbr', state.state_abbr)
    .order('full_name')
    .limit(53),
  // Bills are federal-only in the current schema; show most recent federal bills as placeholder
  supabase
    .from('bills')
    .select('id, bill_number, title, status, introduced_date, last_action_date')
    .order('last_action_date', { ascending: false })
    .limit(10),
  supabase
    .from('elections')
    .select('id, name, election_date, election_type')
    .eq('jurisdiction_id', state.id)
    .gte('election_date', new Date().toISOString().split('T')[0])
    .order('election_date')
    .limit(10),
  supabase
    .from('jurisdictions')
    .select('name, slug, population')
    .eq('level', 'county')
    .eq('state_abbr', state.state_abbr)
    .order('name')
    .limit(200),
  supabase
    .from('jurisdictions')
    .select('name, slug, population')
    .eq('level', 'city')
    .eq('state_abbr', state.state_abbr)
    .order('population', { ascending: false })
    .limit(50),
]);

// ── Role buckets for State Officials section ──────────────────────────────
type OfficeRow = { id: string; title?: string; branch?: string; chamber?: string; district?: string | number };
type OfficialRow = {
  id: string;
  full_name: string;
  slug?: string | null;
  party?: string | null;
  photo_url?: string | null;
  term_start?: string | null;
  term_end?: string | null;
  offices?: OfficeRow | OfficeRow[] | null;
};

const EXECUTIVE_TITLES = ['Governor', 'Lieutenant Governor', 'Attorney General', 'Secretary of State', 'State Treasurer', 'State Comptroller', 'Superintendent of Public Instruction'];

function getOfficeTitle(official: OfficialRow): string {
  const offices = official.offices;
  if (!offices) return '';
  if (Array.isArray(offices)) return offices[0]?.title ?? '';
  return (offices as OfficeRow).title ?? '';
}

function getOfficeDistrict(official: OfficialRow): string | number | null | undefined {
  const offices = official.offices;
  if (!offices) return null;
  if (Array.isArray(offices)) return offices[0]?.district ?? null;
  return (offices as OfficeRow).district ?? null;
}

function isExecutive(official: OfficialRow): boolean {
  const title = getOfficeTitle(official).toLowerCase();
  return EXECUTIVE_TITLES.some(t => title.includes(t.toLowerCase()));
}

function isStateLegislator(official: OfficialRow): boolean {
  const title = getOfficeTitle(official).toLowerCase();
  return (
    title.includes('state senator') ||
    title.includes('state representative') ||
    title.includes('state delegate') ||
    title.includes('state assembly')
  );
}

const executiveOfficials = (officials ?? []).filter(isExecutive) as OfficialRow[];
const stateLegislators = (officials ?? []).filter(isStateLegislator) as OfficialRow[];

// ── Format helpers ─────────────────────────────────────────────────────────
function formatMoney(amount: number | null | undefined): string {
  if (amount == null) return '—';
  if (amount >= 1_000_000_000) return `$${(amount / 1_000_000_000).toFixed(1)}B`;
  if (amount >= 1_000_000) return `$${(amount / 1_000_000).toFixed(1)}M`;
  if (amount >= 1_000) return `$${(amount / 1_000).toFixed(0)}K`;
  return `$${amount.toLocaleString()}`;
}

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

function formatElectionDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

// ── Party helpers ──────────────────────────────────────────────────────────
// DB enum values: democratic, republican, independent, libertarian, green, other
function partyLabel(party: string | null | undefined): string {
  if (!party) return 'Unknown';
  const labels: Record<string, string> = {
    democratic: 'Democrat',
    republican: 'Republican',
    independent: 'Independent',
    libertarian: 'Libertarian',
    green: 'Green',
    other: 'Other',
    // legacy short codes kept for safety
    D: 'Democrat',
    R: 'Republican',
    I: 'Independent',
  };
  return labels[party] ?? party;
}

function partyDot(party: string | null | undefined): string {
  const p = party?.toLowerCase();
  if (p === 'democratic' || p === 'd') return 'bg-blue-500';
  if (p === 'republican' || p === 'r') return 'bg-red-500';
  return 'bg-slate-400';
}

function partyBadge(party: string | null | undefined): string {
  const p = party?.toLowerCase();
  if (p === 'democratic' || p === 'd') return 'bg-blue-100 text-blue-800 border-blue-200';
  if (p === 'republican' || p === 'r') return 'bg-red-100 text-red-800 border-red-200';
  return 'bg-slate-100 text-slate-700 border-slate-200';
}

// ── Bill status helpers ────────────────────────────────────────────────────
function billStatusBadge(status: string | null | undefined): string {
  const s = (status ?? '').toLowerCase();
  if (s.includes('passed') || s.includes('signed')) return 'bg-emerald-100 text-emerald-800';
  if (s.includes('failed') || s.includes('vetoed')) return 'bg-red-100 text-red-800';
  if (s.includes('introduced')) return 'bg-sky-100 text-sky-800';
  if (s.includes('committee')) return 'bg-amber-100 text-amber-800';
  return 'bg-slate-100 text-slate-700';
}

const sections = [
  { id: 'state-officials', label: 'State Officials' },
  { id: 'congressional', label: 'Congressional Delegation' },
  { id: 'legislature', label: 'State Legislature' },
  { id: 'elections', label: 'Elections' },
  { id: 'counties', label: 'Counties' },
  { id: 'cities', label: 'Cities' },
];

const stateName: string = state.name ?? slug ?? '';
const stateAbbr: string = state.state_abbr ?? '';
---

<BaseLayout
  title={stateName}
  description={`State overview for ${stateName} — officials, congressional delegation, legislature, and upcoming elections.`}
>
  <main class="flex-1">

    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-5xl mx-auto">
        <Breadcrumb
          items={[
            { label: 'States', href: '/states' },
            { label: stateName },
          ]}
        />

        <div class="flex flex-col sm:flex-row items-start gap-6 mt-4">

          <!-- Flag placeholder -->
          <div
            class="shrink-0 w-20 h-14 rounded bg-[#2a3f6a] border border-white/20
                   flex items-center justify-center text-white/40 text-xs font-mono font-semibold tracking-wider"
            aria-label={`${stateName} state flag`}
          >
            {stateAbbr || stateName.slice(0, 2).toUpperCase()}
          </div>

          <!-- Identity + stats -->
          <div class="flex-1 min-w-0">
            <h1 class="text-3xl md:text-4xl font-display font-bold mb-4 leading-tight">
              {stateName}
            </h1>

            <!-- Key stats row -->
            <dl class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
              {state.population != null && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-0.5">Population</dt>
                  <dd class="text-white font-medium">{Number(state.population).toLocaleString()}</dd>
                </div>
              )}
              {(() => {
                const governor = executiveOfficials.find(o =>
                  getOfficeTitle(o).toLowerCase().includes('governor') &&
                  !getOfficeTitle(o).toLowerCase().includes('lieutenant')
                );
                return governor ? (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-0.5">Governor</dt>
                    <dd class="text-white font-medium flex items-center gap-1.5">
                      <span class={`inline-block w-2 h-2 rounded-full ${partyDot(governor.party)}`} aria-hidden="true"></span>
                      {governor.full_name}
                    </dd>
                  </div>
                ) : null;
              })()}
              {stateAbbr && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-0.5">Abbreviation</dt>
                  <dd class="text-white font-medium font-mono">{stateAbbr}</dd>
                </div>
              )}
            </dl>
          </div>

        </div>
      </div>
    </section>

    <!-- ── Sticky section nav ─────────────────────────────────────── -->
    <nav
      class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm overflow-x-auto"
      aria-label="Page sections"
    >
      <div class="max-w-5xl mx-auto px-4">
        <ol class="flex items-center gap-0 text-sm font-medium whitespace-nowrap">
          {sections.map(s => (
            <li>
              <a
                href={`#${s.id}`}
                class="block px-4 py-3 text-civic-slate hover:text-civic-blue border-b-2 border-transparent hover:border-civic-blue transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <JurisdictionLayout
      sidebarProps={{
        currentLevel: 'state',
        currentSlug: slug,
        stateName: stateName,
        stateSlug: slug,
        siblingCounties: (counties ?? []).map((c) => ({ name: c.name ?? '', slug: c.slug ?? '' })),
        siblingCities: (cities ?? []).map((c) => ({ name: c.name ?? '', slug: c.slug ?? '' })),
      }}
    >
    <div class="flex flex-col gap-16">

      <!-- ── State Officials ────────────────────────────────────── -->
      <section id="state-officials" aria-labelledby="state-officials-heading">
        <h2 id="state-officials-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          State Officials
        </h2>

        <!-- Executive officers -->
        {executiveOfficials.length > 0 ? (
          <div class="mb-8">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-3">
              Executive Officers
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {executiveOfficials.map(official => (
                <a
                  href={`/officials/${official.slug ?? official.id}`}
                  class="flex items-center gap-3 p-3 rounded-lg border border-slate-200 bg-white
                         hover:border-civic-blue hover:shadow-sm transition-all group"
                >
                  <!-- Initial avatar -->
                  <div
                    class="shrink-0 w-9 h-9 rounded-full bg-slate-100 border border-slate-200
                           flex items-center justify-center text-sm font-display font-bold text-civic-slate
                           group-hover:bg-civic-blue/10 group-hover:border-civic-blue/30 transition-colors"
                    aria-hidden="true"
                  >
                    {official.full_name.charAt(0).toUpperCase()}
                  </div>
                  <div class="min-w-0">
                    <div class="font-medium text-sm text-slate-800 group-hover:text-civic-blue truncate transition-colors">
                      {official.full_name}
                    </div>
                    <div class="flex items-center gap-1.5 mt-0.5">
                      {official.party && (
                        <span class={`inline-flex items-center px-1.5 py-0 rounded text-xs font-medium border ${partyBadge(official.party)}`}>
                          {partyLabel(official.party)}
                        </span>
                      )}
                      <span class="text-xs text-slate-400 truncate">{getOfficeTitle(official)}</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ) : null}

        <!-- State legislators -->
        {stateLegislators.length > 0 ? (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-3">
              State Legislators
            </h3>
            <div class="overflow-x-auto rounded-lg border border-slate-200">
              <table class="min-w-full text-sm">
                <thead>
                  <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                    <th class="px-4 py-3 text-left">Name</th>
                    <th class="px-4 py-3 text-left">Office</th>
                    <th class="px-4 py-3 text-left">Party</th>
                    <th class="px-4 py-3 text-right">Term End</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {stateLegislators.map((official, i) => (
                    <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                      <td class="px-4 py-3">
                        <a
                          href={`/officials/${official.slug ?? official.id}`}
                          class="font-medium text-civic-blue hover:underline"
                        >
                          {official.full_name}
                        </a>
                      </td>
                      <td class="px-4 py-3 text-slate-600">{getOfficeTitle(official) || '—'}</td>
                      <td class="px-4 py-3">
                        {official.party ? (
                          <span class={`inline-flex items-center px-2 py-0.5 rounded-full border text-xs font-medium ${partyBadge(official.party)}`}>
                            {partyLabel(official.party)}
                          </span>
                        ) : (
                          <span class="text-slate-300">—</span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-right text-slate-500">{formatDate(official.term_end)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ) : null}

        {executiveOfficials.length === 0 && stateLegislators.length === 0 && (
          <p class="text-slate-400 italic text-sm">No state official records on file.</p>
        )}
      </section>

      <!-- ── Congressional Delegation ───────────────────────────── -->
      <section id="congressional" aria-labelledby="congressional-heading">
        <h2 id="congressional-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Congressional Delegation
        </h2>

        <!-- Senators -->
        <div class="mb-8">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-3">
            U.S. Senators
          </h3>
          {senators && senators.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {senators.map(senator => (
                <a
                  href={`/officials/${senator.slug ?? senator.id}`}
                  class="flex items-center gap-4 p-4 rounded-lg border border-slate-200 bg-white
                         hover:border-civic-blue hover:shadow-sm transition-all group"
                >
                  <div
                    class="shrink-0 w-11 h-11 rounded-full bg-slate-100 border border-slate-200
                           flex items-center justify-center text-base font-display font-bold text-civic-slate
                           group-hover:bg-civic-blue/10 group-hover:border-civic-blue/30 transition-colors"
                    aria-hidden="true"
                  >
                    {senator.full_name.charAt(0).toUpperCase()}
                  </div>
                  <div class="min-w-0">
                    <div class="font-semibold text-slate-800 group-hover:text-civic-blue truncate transition-colors">
                      {senator.full_name}
                    </div>
                    <div class="flex items-center gap-2 mt-0.5">
                      {senator.party && (
                        <span class={`inline-flex items-center px-2 py-0 rounded-full border text-xs font-medium ${partyBadge(senator.party)}`}>
                          {partyLabel(senator.party)}
                        </span>
                      )}
                      <span class="text-xs text-slate-400">
                        Term ends {formatDate(senator.term_end)}
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="text-slate-400 italic text-sm">No senator records on file.</p>
          )}
        </div>

        <!-- House representatives -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-3">
            U.S. House Representatives
          </h3>
          {houseReps && houseReps.length > 0 ? (
            <div class="overflow-x-auto rounded-lg border border-slate-200">
              <table class="min-w-full text-sm">
                <thead>
                  <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                    <th class="px-4 py-3 text-left">Name</th>
                    <th class="px-4 py-3 text-center">District</th>
                    <th class="px-4 py-3 text-left">Party</th>
                    <th class="px-4 py-3 text-right">Term End</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {houseReps.map((rep, i) => {
                    const repOffices = rep.offices;
                    const repDistrict = Array.isArray(repOffices)
                      ? repOffices[0]?.district
                      : (repOffices as { district?: string | number | null } | null)?.district;
                    return (
                      <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                        <td class="px-4 py-3">
                          <a
                            href={`/officials/${rep.slug ?? rep.id}`}
                            class="font-medium text-civic-blue hover:underline"
                          >
                            {rep.full_name}
                          </a>
                        </td>
                        <td class="px-4 py-3 text-center font-mono text-slate-600">{repDistrict ?? '—'}</td>
                        <td class="px-4 py-3">
                          {rep.party ? (
                            <span class={`inline-flex items-center px-2 py-0.5 rounded-full border text-xs font-medium ${partyBadge(rep.party)}`}>
                              {partyLabel(rep.party)}
                            </span>
                          ) : (
                            <span class="text-slate-300">—</span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-right text-slate-500">{formatDate(rep.term_end)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-slate-400 italic text-sm">No House representative records on file.</p>
          )}
        </div>
      </section>

      <!-- ── State Legislature ──────────────────────────────────── -->
      <section id="legislature" aria-labelledby="legislature-heading">
        <h2 id="legislature-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          State Legislature
        </h2>

        <!-- Recent bills -->
        <h3 class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-3">
          Recent Bills
        </h3>
        {recentBills && recentBills.length > 0 ? (
          <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-civic-slate">
                  <th class="px-4 py-3 text-left">Bill</th>
                  <th class="px-4 py-3 text-left">Title</th>
                  <th class="px-4 py-3 text-center">Status</th>
                  <th class="px-4 py-3 text-right">Last Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {recentBills.map((bill, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                    <td class="px-4 py-3 font-mono font-medium text-civic-blue whitespace-nowrap">
                      {bill.bill_number ?? bill.id ?? '—'}
                    </td>
                    <td class="px-4 py-3 text-slate-700 max-w-[280px]">
                      <div class="line-clamp-2 leading-snug" title={bill.title ?? undefined}>
                        {bill.title ?? '—'}
                      </div>
                    </td>
                    <td class="px-4 py-3 text-center">
                      {bill.status ? (
                        <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ${billStatusBadge(bill.status)}`}>
                          {bill.status}
                        </span>
                      ) : (
                        <span class="text-slate-300">—</span>
                      )}
                    </td>
                    <td class="px-4 py-3 text-right text-slate-500 whitespace-nowrap">
                      {formatDate(bill.last_action_date)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-slate-400 italic text-sm">No bill records on file.</p>
        )}
      </section>

      <!-- ── Elections ──────────────────────────────────────────── -->
      <section id="elections" aria-labelledby="elections-heading">
        <h2 id="elections-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Upcoming Elections
        </h2>

        {upcomingElections && upcomingElections.length > 0 ? (
          <ul class="flex flex-col gap-4" role="list">
            {upcomingElections.map(election => (
              <li
                class="flex flex-col sm:flex-row sm:items-start gap-4 p-5 rounded-lg border border-slate-200 bg-white"
                role="listitem"
              >
                <!-- Date block -->
                <div class="shrink-0 sm:w-28 text-center sm:text-left">
                  <div class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-0.5">Date</div>
                  <time
                    datetime={election.election_date ?? undefined}
                    class="text-sm font-semibold text-civic-navy leading-snug"
                  >
                    {formatElectionDate(election.election_date)}
                  </time>
                </div>

                <!-- Content block -->
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span class="font-semibold text-slate-800">{election.name ?? 'Unnamed Election'}</span>
                    {election.election_type && (
                      <span class="inline-flex items-center px-2 py-0.5 rounded bg-civic-light text-civic-navy text-xs font-medium capitalize">
                        {election.election_type}
                      </span>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="p-6 rounded-lg border border-slate-200 bg-slate-50 text-center">
            <p class="text-slate-400 italic text-sm">No upcoming elections on record for {stateName}.</p>
          </div>
        )}
      </section>

      <!-- ── Counties ───────────────────────────────────────────── -->
      <section id="counties" aria-labelledby="counties-heading">
        <h2 id="counties-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200 flex items-center gap-3">
          Counties
          {counties && counties.length > 0 && (
            <span class="text-sm font-normal text-slate-400 font-sans">
              ({counties.length})
            </span>
          )}
        </h2>

        {counties && counties.length > 0 ? (
          <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-1" role="list">
            {counties.map(county => (
              <li role="listitem" class="text-sm py-0.5">
                <a
                  href={`/counties/${county.slug}`}
                  class="text-civic-blue hover:underline"
                >
                  {county.name}
                </a>
                {county.population != null && (
                  <span class="text-xs text-slate-400 ml-1">
                    (pop. {Number(county.population).toLocaleString()})
                  </span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No county data available.</p>
        )}
      </section>

      <!-- ── Cities ─────────────────────────────────────────────── -->
      <section id="cities" aria-labelledby="cities-heading">
        <h2 id="cities-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200 flex items-center gap-3">
          Largest Cities
          {cities && cities.length > 0 && (
            <span class="text-sm font-normal text-slate-400 font-sans">
              ({cities.length})
            </span>
          )}
        </h2>

        {cities && cities.length > 0 ? (
          <>
            <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-1 mb-6" role="list">
              {cities.map(city => (
                <li role="listitem" class="text-sm py-0.5">
                  <a
                    href={`/cities/${city.slug}`}
                    class="text-civic-blue hover:underline"
                  >
                    {city.name}
                  </a>
                  {city.population != null && (
                    <span class="text-xs text-slate-400 ml-1">
                      (pop. {Number(city.population).toLocaleString()})
                    </span>
                  )}
                </li>
              ))}
            </ul>
            <p class="text-sm text-slate-500">
              <a href={`/states/${slug}/cities`} class="text-civic-blue hover:underline">
                View all cities in {stateName} &rarr;
              </a>
            </p>
          </>
        ) : (
          <p class="text-slate-400 italic text-sm">No city data available.</p>
        )}
      </section>

    </div>
    </JurisdictionLayout>
  </main>
</BaseLayout>
