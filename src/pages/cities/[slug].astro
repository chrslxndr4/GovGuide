---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;

const { data: city } = await supabase
  .from('jurisdictions')
  .select('*')
  .eq('slug', slug)
  .eq('level', 'city')
  .single();

if (!city) return Astro.redirect('/404');

// Fetch related data in parallel
const [
  { data: council },
  { data: elections },
  { data: issues },
] = await Promise.all([
  supabase
    .from('officials')
    .select('id, name, slug, party, title, district')
    .eq('jurisdiction_id', city.id)
    .order('title', { ascending: true }),
  supabase
    .from('elections')
    .select('id, name, election_date, type, status')
    .eq('jurisdiction_id', city.id)
    .order('election_date', { ascending: false })
    .limit(10),
  supabase
    .from('local_issues')
    .select('id, title, category, status, summary, created_at')
    .eq('jurisdiction_id', city.id)
    .order('created_at', { ascending: false })
    .limit(10),
]);

type PartyKey = 'D' | 'R' | 'I' | string;

function partyLabel(party: PartyKey): string {
  const labels: Record<string, string> = { D: 'Democrat', R: 'Republican', I: 'Independent' };
  return labels[party] ?? party ?? 'Unknown';
}

function partyBadge(party: PartyKey): string {
  if (party === 'D') return 'bg-blue-100 text-blue-800 border-blue-200';
  if (party === 'R') return 'bg-red-100 text-red-800 border-red-200';
  return 'bg-slate-100 text-slate-700 border-slate-200';
}

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

// Split out the mayor (title contains 'mayor') from council members
const mayor = council?.find(o => o.title?.toLowerCase().includes('mayor')) ?? null;
const councilMembers = council?.filter(o => !o.title?.toLowerCase().includes('mayor')) ?? [];

const sections = [
  { id: 'council', label: 'Mayor & Council' },
  { id: 'budget', label: 'City Budget' },
  { id: 'issues', label: 'Local Issues' },
  { id: 'elections', label: 'Elections' },
];
---

<BaseLayout
  title={city.name}
  description={`City profile for ${city.name} — mayor and council, city budget, local issues, and elections.`}
>
  <main class="flex-1">

    <!-- Hero -->
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-5xl mx-auto">
        <Breadcrumb
          items={[
            { label: 'Cities', href: '/cities' },
            { label: city.name },
          ]}
        />

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <div
            class="shrink-0 w-20 h-20 rounded-lg bg-[#2a3f6a] border border-white/20
                   flex items-center justify-center text-2xl font-display font-bold text-white/60"
            aria-hidden="true"
          >
            {city.state_code ?? '??'}
          </div>

          <div class="flex-1 min-w-0">
            <h1 class="text-3xl md:text-4xl font-display font-bold mb-2 leading-tight">
              {city.name}
            </h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-300">
              {city.state_name && <span>{city.state_name}</span>}
              {city.population != null && (
                <>
                  <span class="text-slate-500" aria-hidden="true">·</span>
                  <span>Pop. {city.population.toLocaleString()}</span>
                </>
              )}
              {city.county_name && (
                <>
                  <span class="text-slate-500" aria-hidden="true">·</span>
                  <span>{city.county_name} County</span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky section nav -->
    <nav
      class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm overflow-x-auto"
      aria-label="City sections"
    >
      <div class="max-w-5xl mx-auto px-4">
        <ol class="flex items-center gap-0 text-sm font-medium whitespace-nowrap">
          {sections.map(s => (
            <li>
              <a
                href={`#${s.id}`}
                class="block px-4 py-3 text-civic-slate hover:text-civic-blue border-b-2 border-transparent hover:border-civic-blue transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-10 flex flex-col gap-16">

      <!-- ── Mayor & Council ───────────────────────────────────── -->
      <section id="council" aria-labelledby="council-heading">
        <h2 id="council-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Mayor &amp; Council
        </h2>

        {/* Mayor spotlight */}
        {mayor && (
          <div class="mb-6 p-5 rounded-lg border border-civic-blue/30 bg-blue-50/40">
            <div class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-2">Mayor</div>
            <div class="flex items-center gap-4">
              <div
                class="shrink-0 w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center
                       text-lg font-display font-bold text-civic-navy"
                aria-hidden="true"
              >
                {mayor.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <a href={`/officials/${mayor.slug}`} class="font-bold text-lg text-civic-navy hover:text-civic-blue transition-colors">
                  {mayor.name}
                </a>
                {mayor.party && (
                  <div class="mt-1">
                    <span class={`inline-flex px-2 py-0.5 rounded text-xs font-semibold border ${partyBadge(mayor.party)}`}>
                      {partyLabel(mayor.party)}
                    </span>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* Council members */}
        {councilMembers.length > 0 ? (
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
            {councilMembers.map(member => (
              <li>
                <a
                  href={`/officials/${member.slug}`}
                  class="flex items-center gap-3 p-4 rounded-lg border border-slate-200 bg-white hover:border-civic-blue hover:shadow-sm transition-all"
                >
                  <div
                    class="shrink-0 w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center
                           text-sm font-display font-bold text-slate-500"
                    aria-hidden="true"
                  >
                    {member.name.charAt(0).toUpperCase()}
                  </div>
                  <div class="min-w-0">
                    <div class="font-semibold text-slate-800 truncate">{member.name}</div>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-xs text-civic-slate truncate">
                        {member.title ?? 'Council Member'}{member.district ? ` · District ${member.district}` : ''}
                      </span>
                      {member.party && (
                        <span class={`inline-flex px-1.5 py-0.5 rounded text-xs font-semibold border ${partyBadge(member.party)}`}>
                          {partyLabel(member.party)}
                        </span>
                      )}
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : !mayor ? (
          <p class="text-slate-400 italic text-sm">No officials on record for this city.</p>
        ) : null}
      </section>

      <!-- ── City Budget ────────────────────────────────────────── -->
      <section id="budget" aria-labelledby="budget-heading">
        <h2 id="budget-heading" class="text-xl font-display text-civic-navy mb-2 pb-2 border-b border-slate-200">
          City Budget
        </h2>
        <p class="text-xs text-civic-slate mb-6">
          Budget and expenditure data for {city.name}. Sourced from city financial disclosures.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {[
            { label: 'Annual Budget', value: city.annual_budget },
            { label: 'Per Capita Spending', value: city.per_capita_spending },
            { label: 'Fiscal Year', value: city.fiscal_year },
          ].map(stat => (
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <div class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-1">
                {stat.label}
              </div>
              <div class="text-2xl font-display font-bold text-civic-navy">
                {stat.value != null
                  ? typeof stat.value === 'number'
                    ? `$${stat.value.toLocaleString()}`
                    : stat.value
                  : <span class="text-slate-300 text-base font-normal italic">Not available</span>
                }
              </div>
            </div>
          ))}
        </div>

        {city.budget_url && (
          <div class="mt-4">
            <a
              href={city.budget_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-civic-blue hover:underline"
            >
              View full budget document &rarr;
            </a>
          </div>
        )}
      </section>

      <!-- ── Local Issues ───────────────────────────────────────── -->
      <section id="issues" aria-labelledby="issues-heading">
        <h2 id="issues-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Local Issues
        </h2>

        {issues && issues.length > 0 ? (
          <ul class="flex flex-col gap-4" role="list">
            {issues.map(issue => (
              <li class="rounded-lg border border-slate-200 bg-white p-4">
                <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                  <h3 class="font-semibold text-slate-800">{issue.title}</h3>
                  <div class="flex items-center gap-2 shrink-0">
                    {issue.category && (
                      <span class="text-xs font-medium px-2 py-0.5 rounded bg-slate-100 text-civic-slate capitalize">
                        {issue.category.replace(/_/g, ' ')}
                      </span>
                    )}
                    {issue.status && (
                      <span class={`text-xs font-semibold px-2 py-0.5 rounded capitalize ${
                        issue.status === 'active'
                          ? 'bg-blue-100 text-blue-700'
                          : issue.status === 'resolved'
                          ? 'bg-emerald-100 text-emerald-700'
                          : 'bg-slate-100 text-slate-600'
                      }`}>
                        {issue.status}
                      </span>
                    )}
                  </div>
                </div>
                {issue.summary && (
                  <p class="text-sm text-slate-600 leading-relaxed">{issue.summary}</p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No local issues on record for this city.</p>
        )}
      </section>

      <!-- ── Elections ─────────────────────────────────────────── -->
      <section id="elections" aria-labelledby="elections-heading">
        <h2 id="elections-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Elections
        </h2>

        {elections && elections.length > 0 ? (
          <ul class="flex flex-col gap-3" role="list">
            {elections.map(election => (
              <li class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-4 rounded-lg border border-slate-200 bg-white">
                <div>
                  <div class="font-semibold text-slate-800">{election.name}</div>
                  <div class="text-xs text-civic-slate mt-0.5 capitalize">{election.type ?? 'General'}</div>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="text-sm text-slate-500">{formatDate(election.election_date)}</span>
                  {election.status && (
                    <span class={`text-xs font-semibold px-2 py-0.5 rounded capitalize ${
                      election.status === 'upcoming'
                        ? 'bg-blue-100 text-blue-700'
                        : election.status === 'completed'
                        ? 'bg-emerald-100 text-emerald-700'
                        : 'bg-slate-100 text-slate-600'
                    }`}>
                      {election.status}
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No election records for this city.</p>
        )}
      </section>

    </div>
  </main>
</BaseLayout>
