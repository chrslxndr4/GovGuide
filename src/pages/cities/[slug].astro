---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;

const { data: city } = await supabase
  .from('jurisdictions')
  .select('*')
  .eq('slug', slug)
  .eq('level', 'city')
  .single();

if (!city) return Astro.redirect('/404');

// Look up parent state name/slug, county name/slug, and sibling cities in parallel with other queries
const [
  { data: parentState },
  { data: parentCounty },
  { data: council },
  { data: elections },
  { data: siblingCities },
] = await Promise.all([
  // State name + slug: match on state_abbr + level='state'
  city.state_abbr
    ? supabase
        .from('jurisdictions')
        .select('name, slug')
        .eq('level', 'state')
        .eq('state_abbr', city.state_abbr)
        .single()
    : Promise.resolve({ data: null }),

  // County name + slug: look up parent jurisdiction if parent_id exists
  city.parent_id
    ? supabase
        .from('jurisdictions')
        .select('name, slug')
        .eq('id', city.parent_id)
        .single()
    : Promise.resolve({ data: null }),

  // Officials joined through offices
  supabase
    .from('officials')
    .select('id, full_name, slug, party, photo_url, offices!inner(title, branch, district, jurisdiction_id)')
    .eq('is_current', true)
    .eq('offices.jurisdiction_id', city.id)
    .order('full_name'),

  // Elections — use election_type, no type/status columns
  supabase
    .from('elections')
    .select('id, name, election_date, election_type, registration_deadline')
    .eq('jurisdiction_id', city.id)
    .order('election_date', { ascending: false })
    .limit(10),

  // Sibling cities in same state, ordered by population
  city.state_abbr
    ? supabase
        .from('jurisdictions')
        .select('name, slug, population')
        .eq('level', 'city')
        .eq('state_abbr', city.state_abbr)
        .neq('slug', slug)
        .order('population', { ascending: false })
        .limit(12)
    : Promise.resolve({ data: null }),
]);

const stateName: string | null = parentState?.name ?? null;
const stateSlug: string | null = parentState?.slug ?? null;
const countyName: string | null = parentCounty?.name ?? null;
const countySlug: string | null = parentCounty?.slug ?? null;

type PartyEnum = 'democratic' | 'republican' | 'independent' | 'libertarian' | 'green' | 'other' | string;

function partyLabel(party: PartyEnum): string {
  const labels: Record<string, string> = {
    democratic: 'Democrat',
    republican: 'Republican',
    independent: 'Independent',
    libertarian: 'Libertarian',
    green: 'Green',
    other: 'Other',
  };
  return labels[party?.toLowerCase()] ?? party ?? 'Unknown';
}

function partyBadge(party: PartyEnum): string {
  const p = party?.toLowerCase();
  if (p === 'democratic') return 'bg-blue-100 text-blue-800 border-blue-200';
  if (p === 'republican') return 'bg-red-100 text-red-800 border-red-200';
  return 'bg-slate-100 text-slate-700 border-slate-200';
}

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

// Split out the mayor from council members using the joined office title
const mayor = council?.find(o => {
  const officeTitle = Array.isArray(o.offices) ? o.offices[0]?.title : (o.offices as { title?: string } | null)?.title;
  return officeTitle?.toLowerCase().includes('mayor');
}) ?? null;

const councilMembers = council?.filter(o => {
  const officeTitle = Array.isArray(o.offices) ? o.offices[0]?.title : (o.offices as { title?: string } | null)?.title;
  return !officeTitle?.toLowerCase().includes('mayor');
}) ?? [];

function getOfficeTitle(o: (typeof council)[number]): string {
  const officeTitle = Array.isArray(o.offices) ? o.offices[0]?.title : (o.offices as { title?: string } | null)?.title;
  return officeTitle ?? 'Council Member';
}

function getOfficeDistrict(o: (typeof council)[number]): string | null {
  const district = Array.isArray(o.offices) ? o.offices[0]?.district : (o.offices as { district?: string } | null)?.district;
  return district ?? null;
}

const sections = [
  { id: 'council', label: 'Mayor & Council' },
  { id: 'elections', label: 'Elections' },
  { id: 'see-also', label: 'See Also' },
];
---

<BaseLayout
  title={city.name}
  description={`City profile for ${city.name} — mayor and council, and upcoming elections.`}
>
  <main class="flex-1">

    <!-- Hero -->
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-5xl mx-auto">
        <Breadcrumb
          items={[
            { label: 'States', href: '/states' },
            ...(stateSlug && stateName ? [{ label: stateName, href: `/states/${stateSlug}` }] : []),
            ...(countySlug && countyName ? [{ label: countyName, href: `/counties/${countySlug}` }] : []),
            { label: city.name },
          ]}
        />

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <div
            class="shrink-0 w-20 h-20 rounded-lg bg-[#2a3f6a] border border-white/20
                   flex items-center justify-center text-2xl font-display font-bold text-white/60"
            aria-hidden="true"
          >
            {city.state_abbr ?? '??'}
          </div>

          <div class="flex-1 min-w-0">
            <h1 class="text-3xl md:text-4xl font-display font-bold mb-2 leading-tight">
              {city.name}
            </h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-300">
              {stateName && <span>{stateName}</span>}
              {city.population != null && (
                <>
                  <span class="text-slate-500" aria-hidden="true">·</span>
                  <span>Pop. {city.population.toLocaleString()}</span>
                </>
              )}
              {countyName && (
                <>
                  <span class="text-slate-500" aria-hidden="true">·</span>
                  <span>{countyName} County</span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky section nav -->
    <nav
      class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm overflow-x-auto"
      aria-label="City sections"
    >
      <div class="max-w-5xl mx-auto px-4">
        <ol class="flex items-center gap-0 text-sm font-medium whitespace-nowrap">
          {sections.map(s => (
            <li>
              <a
                href={`#${s.id}`}
                class="block px-4 py-3 text-civic-slate hover:text-civic-blue border-b-2 border-transparent hover:border-civic-blue transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-10 flex flex-col gap-16">

      <!-- ── Mayor & Council ───────────────────────────────────── -->
      <section id="council" aria-labelledby="council-heading">
        <h2 id="council-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Mayor &amp; Council
        </h2>

        {/* Mayor spotlight */}
        {mayor && (
          <div class="mb-6 p-5 rounded-lg border border-civic-blue/30 bg-blue-50/40">
            <div class="text-xs font-semibold uppercase tracking-widest text-civic-slate mb-2">Mayor</div>
            <div class="flex items-center gap-4">
              <div
                class="shrink-0 w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center
                       text-lg font-display font-bold text-civic-navy"
                aria-hidden="true"
              >
                {mayor.full_name.charAt(0).toUpperCase()}
              </div>
              <div>
                <a href={`/officials/${mayor.slug}`} class="font-bold text-lg text-civic-navy hover:text-civic-blue transition-colors">
                  {mayor.full_name}
                </a>
                {mayor.party && (
                  <div class="mt-1">
                    <span class={`inline-flex px-2 py-0.5 rounded text-xs font-semibold border ${partyBadge(mayor.party)}`}>
                      {partyLabel(mayor.party)}
                    </span>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* Council members */}
        {councilMembers.length > 0 ? (
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
            {councilMembers.map(member => (
              <li>
                <a
                  href={`/officials/${member.slug}`}
                  class="flex items-center gap-3 p-4 rounded-lg border border-slate-200 bg-white hover:border-civic-blue hover:shadow-sm transition-all"
                >
                  <div
                    class="shrink-0 w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center
                           text-sm font-display font-bold text-slate-500"
                    aria-hidden="true"
                  >
                    {member.full_name.charAt(0).toUpperCase()}
                  </div>
                  <div class="min-w-0">
                    <div class="font-semibold text-slate-800 truncate">{member.full_name}</div>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-xs text-civic-slate truncate">
                        {getOfficeTitle(member)}{getOfficeDistrict(member) ? ` · District ${getOfficeDistrict(member)}` : ''}
                      </span>
                      {member.party && (
                        <span class={`inline-flex px-1.5 py-0.5 rounded text-xs font-semibold border ${partyBadge(member.party)}`}>
                          {partyLabel(member.party)}
                        </span>
                      )}
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : !mayor ? (
          <p class="text-slate-400 italic text-sm">No officials on record for this city.</p>
        ) : null}
      </section>

      <!-- ── City Budget ────────────────────────────────────────── -->
      <section id="budget" aria-labelledby="budget-heading">
        <h2 id="budget-heading" class="text-xl font-display text-civic-navy mb-2 pb-2 border-b border-slate-200">
          City Budget
        </h2>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-6 text-center">
          <p class="text-civic-slate text-sm">
            Detailed budget data is not yet available for {city.name}.
          </p>
          {city.website && (
            <a
              href={city.website}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-civic-blue hover:underline mt-3"
            >
              Visit {city.name} official website &rarr;
            </a>
          )}
        </div>
      </section>

      <!-- ── Elections ─────────────────────────────────────────── -->
      <section id="elections" aria-labelledby="elections-heading">
        <h2 id="elections-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Elections
        </h2>

        {elections && elections.length > 0 ? (
          <ul class="flex flex-col gap-3" role="list">
            {elections.map(election => (
              <li class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-4 rounded-lg border border-slate-200 bg-white">
                <div>
                  <div class="font-semibold text-slate-800">{election.name}</div>
                  {election.election_type && (
                    <div class="text-xs text-civic-slate mt-0.5 capitalize">
                      {election.election_type.replace(/_/g, ' ')}
                    </div>
                  )}
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="text-sm text-slate-500">{formatDate(election.election_date)}</span>
                  {election.registration_deadline && (
                    <span class="text-xs text-civic-slate">
                      Reg. deadline: {formatDate(election.registration_deadline)}
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 italic text-sm">No election records for this city.</p>
        )}
      </section>

      <!-- ── Other Cities in State ─────────────────────────────── -->
      <section id="see-also" aria-labelledby="see-also-heading">
        <h2 id="see-also-heading" class="text-xl font-display text-civic-navy mb-6 pb-2 border-b border-slate-200">
          Other Cities in {stateName ?? city.state_abbr}
        </h2>

        {siblingCities && siblingCities.length > 0 ? (
          <>
            <ul
              class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-1"
              role="list"
            >
              {siblingCities.map(sibling => (
                <li class="flex items-baseline gap-1 min-w-0">
                  <a
                    href={`/cities/${sibling.slug}`}
                    class="text-sm text-blue-600 hover:underline no-underline truncate"
                  >
                    {sibling.name}
                  </a>
                  {sibling.population != null && (
                    <span class="text-xs text-slate-400 ml-1 shrink-0">
                      (pop.&nbsp;{sibling.population.toLocaleString()})
                    </span>
                  )}
                </li>
              ))}
            </ul>
            {stateSlug && stateName && (
              <a
                href={`/states/${stateSlug}#cities`}
                class="text-sm text-blue-600 hover:underline font-medium mt-3 inline-block"
              >
                View all cities in {stateName} &rarr;
              </a>
            )}
          </>
        ) : (
          <p class="text-slate-400 italic text-sm">No sibling city data available.</p>
        )}
      </section>

    </div>
  </main>
</BaseLayout>
