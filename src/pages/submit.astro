---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubmissionForm from '../components/community/SubmissionForm';
---

<BaseLayout
  title="Submit a Correction or Tip"
  description="Help improve GovGuide by submitting corrections, additions, updates, or tips about local and federal government data."
>
  <main class="flex-1 bg-civic-light">

    {/* Hero */}
    <section class="bg-civic-navy text-white py-10 px-4">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl font-display font-bold mb-3">
          Submit a Correction or Tip
        </h1>
        <p class="text-slate-300 text-base leading-relaxed max-w-2xl">
          GovGuide is only as accurate as the data behind it. If you spot an error, know
          about a missing official, or have a tip on government financial activity, submit
          it here. Every submission is reviewed by our team before publication.
        </p>

        {/* Process steps */}
        <div class="mt-7 grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white/10 border border-white/20 rounded-lg px-4 py-4">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">
              Step 1
            </p>
            <p class="text-sm font-medium text-white mb-1">Fill out the form</p>
            <p class="text-xs text-slate-400">
              Describe what's wrong or missing and provide a verifiable source URL.
            </p>
          </div>
          <div class="bg-white/10 border border-white/20 rounded-lg px-4 py-4">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">
              Step 2
            </p>
            <p class="text-sm font-medium text-white mb-1">We review it</p>
            <p class="text-xs text-slate-400">
              Our team verifies the source and cross-references it against existing records.
            </p>
          </div>
          <div class="bg-white/10 border border-white/20 rounded-lg px-4 py-4">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">
              Step 3
            </p>
            <p class="text-sm font-medium text-white mb-1">Data is updated</p>
            <p class="text-xs text-slate-400">
              Verified submissions are incorporated and attributed as community-sourced.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Source quality note */}
    <div class="border-b border-slate-200 bg-amber-50">
      <div class="max-w-3xl mx-auto px-4 py-3 flex items-start gap-2.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"
            clip-rule="evenodd"
          />
        </svg>
        <p class="text-xs text-amber-800">
          <strong>Sources required.</strong> GovGuide only publishes information backed by primary
          government records, official filings, or established news organizations. Submissions
          without a verifiable source URL will not be approved.
        </p>
      </div>
    </div>

    {/* Form */}
    <div class="max-w-3xl mx-auto px-4 py-10">
      <SubmissionForm client:load />
    </div>

    {/* Footer note */}
    <div class="max-w-3xl mx-auto px-4 pb-12">
      <div class="border-t border-slate-200 pt-6">
        <p class="text-xs text-civic-slate leading-relaxed">
          GovGuide does not publish anonymous allegations without documentary evidence. If you
          have information about potential wrongdoing, please include a source that supports
          your claim. Contact email addresses are never shared or published.
        </p>
      </div>
    </div>

  </main>
</BaseLayout>
