---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { supabase } from '../../lib/supabase';

const { count: contributionCount } = await supabase
  .from('contributions')
  .select('*', { count: 'exact', head: true });

const { count: lobbyingCount } = await supabase
  .from('lobbying_registrations')
  .select('*', { count: 'exact', head: true });

const { count: tradeCount } = await supabase
  .from('stock_trades')
  .select('*', { count: 'exact', head: true });

const { count: entityCount } = await supabase
  .from('entities')
  .select('*', { count: 'exact', head: true });
---
<BaseLayout title="Follow the Money">
  <Header />
  <main id="main-content" class="flex-1">
    <section class="bg-civic-navy text-white py-12 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">Follow the Money</h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto">
          Trace campaign contributions, lobbying expenditures, stock trades, and dark money flows
          through the political system.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        <div class="bg-white rounded-lg shadow p-4 text-center">
          <p class="text-3xl font-bold text-civic-navy">{(entityCount ?? 0).toLocaleString()}</p>
          <p class="text-sm text-civic-slate">Tracked Entities</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 text-center">
          <p class="text-3xl font-bold text-civic-navy">{(contributionCount ?? 0).toLocaleString()}</p>
          <p class="text-sm text-civic-slate">Contributions</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 text-center">
          <p class="text-3xl font-bold text-civic-navy">{(lobbyingCount ?? 0).toLocaleString()}</p>
          <p class="text-sm text-civic-slate">Lobbying Registrations</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 text-center">
          <p class="text-3xl font-bold text-civic-navy">{(tradeCount ?? 0).toLocaleString()}</p>
          <p class="text-sm text-civic-slate">Stock Trades</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <CategoryCard
          title="Money Graph Explorer"
          description="Interactive visualization of money flows between donors, PACs, and officials"
          href="/money/graph"
        />
        <CategoryCard
          title="Lobbying Dashboard"
          description="Who's lobbying whom, on what bills, and how much they're spending"
          href="/money/lobbying"
        />
        <CategoryCard
          title="Congressional Stock Tracker"
          description="Track stock trades by members of Congress and STOCK Act compliance"
          href="/money/stocks"
        />
        <CategoryCard
          title="Dark Money Tracker"
          description="Trace 501(c)(4) grants, super PAC expenditures, and dark money chains"
          href="/money/dark-money"
        />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
