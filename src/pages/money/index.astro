---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { supabase } from '../../lib/supabase';

const { count: contributionCount } = await supabase.from('contributions').select('*', { count: 'exact', head: true });
const { count: lobbyingCount } = await supabase.from('lobbying_registrations').select('*', { count: 'exact', head: true });
const { count: tradeCount } = await supabase.from('stock_trades').select('*', { count: 'exact', head: true });
const { count: entityCount } = await supabase.from('entities').select('*', { count: 'exact', head: true });
---
<BaseLayout title="Follow the Money">
  <Header />
  <main id="main-content" class="flex-1 bg-surface-50">

    <!-- Hero -->
    <section class="bg-white border-b border-border px-4 py-10">
      <div class="max-w-7xl mx-auto">
        <p class="text-xs font-medium text-civic-blue uppercase tracking-widest mb-2">GovGuide / Money</p>
        <h1 class="text-3xl md:text-4xl font-display font-bold text-civic-navy mb-2">Follow the Money</h1>
        <p class="text-sm text-muted max-w-2xl">
          Trace campaign contributions, lobbying expenditures, stock trades, and dark money flows through the political system.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 py-8">

      <!-- Stat cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        <div class="bg-white border border-border rounded-card px-5 py-4">
          <p class="text-2xl font-bold font-mono tabular-nums text-civic-navy leading-none mb-1">
            {(entityCount ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Tracked Entities</p>
        </div>
        <div class="bg-white border border-border rounded-card px-5 py-4">
          <p class="text-2xl font-bold font-mono tabular-nums text-civic-navy leading-none mb-1">
            {(contributionCount ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Contributions</p>
        </div>
        <div class="bg-white border border-border rounded-card px-5 py-4">
          <p class="text-2xl font-bold font-mono tabular-nums text-civic-navy leading-none mb-1">
            {(lobbyingCount ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Lobbying Registrations</p>
        </div>
        <div class="bg-white border border-border rounded-card px-5 py-4">
          <p class="text-2xl font-bold font-mono tabular-nums text-civic-navy leading-none mb-1">
            {(tradeCount ?? 0).toLocaleString()}
          </p>
          <p class="text-xs text-muted">Stock Trades</p>
        </div>
      </div>

      <!-- Section header -->
      <div class="flex items-center gap-3 mb-5">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Data Categories</h2>
        <div class="flex-1 h-px bg-border"></div>
      </div>

      <!-- Category cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <CategoryCard
          title="Money Graph Explorer"
          description="Interactive visualization of money flows between donors, PACs, and officials"
          href="/money/graph"
        />
        <CategoryCard
          title="Lobbying Dashboard"
          description="Who's lobbying whom, on what bills, and how much they're spending"
          href="/money/lobbying"
        />
        <CategoryCard
          title="Congressional Stock Tracker"
          description="Track stock trades by members of Congress and STOCK Act compliance"
          href="/money/stocks"
        />
        <CategoryCard
          title="Dark Money Tracker"
          description="Trace 501(c)(4) grants, super PAC expenditures, and dark money chains"
          href="/money/dark-money"
        />
      </div>

    </section>
  </main>
  <Footer />
</BaseLayout>
