---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import StockTracker from '../../../components/stock/StockTracker';
import { supabase } from '../../../lib/supabase';

export const prerender = false;

// Hero stats sourced from mv_trade_conflicts so flagged count is accurate.
const { count: totalTrades } = await supabase
  .from('mv_trade_conflicts')
  .select('*', { count: 'exact', head: true });

const { count: lateCount } = await supabase
  .from('mv_trade_conflicts')
  .select('*', { count: 'exact', head: true })
  .gt('days_late', 0);

const { count: flaggedCount } = await supabase
  .from('mv_trade_conflicts')
  .select('*', { count: 'exact', head: true })
  .gt('conflict_severity', 0);
---
<BaseLayout title="Congressional Stock Tracker — GovGuide">
  <Header />
  <main id="main-content" class="flex-1">

    <!-- Hero -->
    <section class="bg-civic-navy text-white py-12 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="mb-6 text-center">
          <h1 class="text-4xl font-display font-bold mb-3">Congressional Stock Tracker</h1>
          <p class="text-lg text-slate-300 max-w-2xl mx-auto">
            Track stock trades by members of Congress. The STOCK Act requires disclosure within 45 days.
            Trades are cross-referenced with committee assignments, donor networks, and regulatory activity.
          </p>
        </div>

        <!-- Hero stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto mt-8">
          <div class="bg-white/10 border border-white/20 rounded-lg px-5 py-4 text-center">
            <p class="text-3xl font-display font-bold text-white">{(totalTrades ?? 0).toLocaleString()}</p>
            <p class="text-sm text-slate-300 mt-1">Total trades tracked</p>
          </div>
          <div class="bg-white/10 border border-white/20 rounded-lg px-5 py-4 text-center">
            <p class="text-3xl font-display font-bold text-civic-gold">{(lateCount ?? 0).toLocaleString()}</p>
            <p class="text-sm text-slate-300 mt-1">Late STOCK Act filings</p>
          </div>
          <div class="bg-white/10 border border-white/20 rounded-lg px-5 py-4 text-center">
            <p class="text-3xl font-display font-bold text-red-400">{(flaggedCount ?? 0).toLocaleString()}</p>
            <p class="text-sm text-slate-300 mt-1">
              Conflict-flagged trades —
              <a href="/conflicts" class="underline underline-offset-2 hover:text-white transition-colors ml-1">
                view conflicts
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive tracker -->
    <section class="max-w-7xl mx-auto px-4 py-8">
      <StockTracker client:load />
    </section>

  </main>
  <Footer />
</BaseLayout>
