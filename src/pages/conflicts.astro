---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConflictFeed from '../components/conflicts/ConflictFeed';
---

<BaseLayout
  title="Conflict Alert Feed"
  description="Algorithmically detected conflicts of interest — donor-vote correlations, stock trades overlapping committee jurisdiction, trade timing anomalies, and more."
>
  <main class="flex-1 bg-civic-light">

    {/* Hero */}
    <section class="bg-civic-navy text-white py-8 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-start justify-between gap-6 flex-wrap">
          <div>
            <h1 class="text-3xl font-display font-bold mb-2">Conflict Alert Feed</h1>
            <p class="text-slate-300 max-w-2xl">
              Algorithmically detected conflicts of interest across government — donor-vote
              correlations, stock trades overlapping committee jurisdiction, judicial financial
              ties, trade timing anomalies, and prediction market divergences.
            </p>
          </div>

          {/* Severity scale badge */}
          <div class="bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-sm shrink-0">
            <p class="font-semibold text-white mb-1.5">Severity Scale</p>
            <div class="flex flex-col gap-1 text-xs">
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                8–10 Critical
              </span>
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-400 inline-block"></span>
                6–7 High
              </span>
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span>
                4–5 Medium
              </span>
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-400 inline-block"></span>
                1–3 Low
              </span>
            </div>
          </div>
        </div>

        {/* Alert type legend */}
        <div class="mt-5 flex flex-wrap gap-4 text-xs text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-purple-400 inline-block"></span>
            Donor / Vote correlation
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400 inline-block"></span>
            Stock / Committee overlap
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-orange-400 inline-block"></span>
            Trade timing anomaly
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-blue-400 inline-block"></span>
            Judicial financial tie
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-pink-400 inline-block"></span>
            Prediction market anomaly
          </span>
        </div>
      </div>
    </section>

    {/* React island */}
    <div class="max-w-7xl mx-auto px-4 py-8">
      <ConflictFeed client:load />
    </div>

  </main>
</BaseLayout>
