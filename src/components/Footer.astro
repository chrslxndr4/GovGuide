---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Navigate',
    links: [
      { label: 'Federal Government', href: '/federal' },
      { label: 'State Governments', href: '/states' },
      { label: 'Counties & Cities', href: '/counties-cities' },
      { label: 'Officials Directory', href: '/officials' },
      { label: 'Elections & Voting', href: '/elections' },
      { label: 'Agencies', href: '/agencies' },
    ],
  },
  {
    heading: 'Follow the Money',
    links: [
      { label: 'Money Graph', href: '/money/graph' },
      { label: 'Dark Money', href: '/money/dark-money' },
      { label: 'Lobbying', href: '/money/lobbying' },
      { label: 'Stock Tracker', href: '/money/stocks' },
      { label: 'Corporate Influence', href: '/money/corporate' },
    ],
  },
  {
    heading: 'Connect the Dots',
    links: [
      { label: 'Conflict Alerts', href: '/connect/conflicts' },
      { label: 'Judicial Transparency', href: '/connect/judicial' },
      { label: 'Predictions', href: '/connect/predictions' },
      { label: 'Scorecards', href: '/connect/scorecards' },
      { label: 'Local Guide', href: '/connect/local' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Blog', href: '/blog' },
      { label: 'Data Sources', href: '/data-sources' },
      { label: 'API', href: '/api' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
    ],
  },
];

const social = [
  {
    label: 'Twitter / X',
    href: 'https://twitter.com/govguide',
    // X (Twitter) icon path
    d: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z',
    viewBox: '0 0 24 24',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/govguide',
    d: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.194 22 16.44 22 12.017 22 6.484 17.522 2 12 2z',
    viewBox: '0 0 24 24',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/company/govguide',
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    viewBox: '0 0 24 24',
  },
];
---

<footer class="bg-civic-navy text-slate-400 mt-auto">

  <!-- Main content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 pb-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-6">

      <!-- Brand column — takes 1 extra unit on large screens -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block font-display text-white text-xl font-bold tracking-tight hover:opacity-80 transition-opacity">
          GovGuide
        </a>
        <p class="mt-3 text-sm leading-relaxed text-slate-400 max-w-xs">
          Free, public civic transparency platform mapping every level of US government.
        </p>
        <!-- Social row -->
        <div class="flex items-center gap-3 mt-5">
          {social.map(s => (
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-8 h-8 rounded text-slate-500 hover:text-white transition-colors duration-fast"
            >
              <svg class="w-4 h-4" viewBox={s.viewBox} fill="currentColor" aria-hidden="true">
                <path d={s.d} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      {columns.map(col => (
        <div>
          <h4 class="text-white text-xs font-semibold uppercase tracking-widest mb-4">
            {col.heading}
          </h4>
          <ul class="flex flex-col gap-2.5">
            {col.links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 hover:text-white transition-colors duration-fast"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-slate-500">
        &copy; {year} GovGuide. Open data, open government.
      </p>
      <p class="text-xs text-slate-600">
        Data sourced from official government APIs and public records.
      </p>
    </div>
  </div>

</footer>
