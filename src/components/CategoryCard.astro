---
interface Props {
  title: string;
  description: string;
  href: string;
  count?: number;
}
const { title, description, href, count } = Astro.props;
---
<a
  href={href}
  class="group block bg-white rounded-md border border-slate-200 p-5 transition-all duration-150 hover:border-blue-400 hover:-translate-y-px hover:shadow-sm"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-sm font-semibold text-slate-800 group-hover:text-blue-600 transition-colors leading-snug">
      {title}
    </h3>
    {count !== undefined && (
      <span class="shrink-0 text-xs font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded tabular-nums">
        {count}
      </span>
    )}
  </div>
  <p class="text-xs text-slate-500 mt-2 leading-relaxed">{description}</p>
  <span class="inline-flex items-center gap-1 text-xs text-blue-500 mt-3 font-medium group-hover:text-blue-600 transition-colors">
    Explore
    <svg class="w-3 h-3 transition-transform duration-150 group-hover:translate-x-0.5" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>
