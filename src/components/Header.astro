---
const pillars = [
  {
    label: 'Navigate',
    items: [
      { label: 'Federal Government', href: '/federal' },
      { label: 'State & Local', href: '/states' },
      { label: 'Elections & Voting', href: '/elections' },
      { label: 'Laws & Legislation', href: '/laws' },
      { label: 'Officials Directory', href: '/officials' },
    ],
  },
  {
    label: 'Follow the Money',
    items: [
      { label: 'Money Graph Explorer', href: '/money/graph' },
      { label: 'Campaign Finance', href: '/money' },
      { label: 'Lobbying Dashboard', href: '/money/lobbying' },
      { label: 'Stock Tracker', href: '/money/stocks' },
      { label: 'Dark Money', href: '/money/dark-money' },
    ],
  },
  {
    label: 'Connect the Dots',
    items: [
      { label: 'Conflict Alerts', href: '/conflicts' },
      { label: 'Judicial Center', href: '/judicial' },
      { label: 'Predictions & Markets', href: '/predictions' },
    ],
  },
];
---
<header class="bg-civic-navy text-white relative z-50">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-display text-2xl font-bold tracking-tight">GovGuide</a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-1">
      {pillars.map((pillar) => (
        <div class="relative group">
          <button
            class="px-3 py-2 text-sm font-medium text-slate-300 hover:text-white transition-colors flex items-center gap-1"
            aria-haspopup="true"
          >
            {pillar.label}
            <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full pt-1 hidden group-hover:block">
            <div class="bg-white rounded-lg shadow-lg border border-slate-200 py-2 min-w-[200px]">
              {pillar.items.map((item) => (
                <a
                  href={item.href}
                  class="block px-4 py-2 text-sm text-civic-navy hover:bg-slate-50 transition-colors"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <form action="/api/search" method="get" class="ml-4">
        <input
          type="search"
          name="q"
          placeholder="Search..."
          class="px-3 py-1.5 text-sm bg-white/10 border border-white/20 rounded-lg text-white placeholder-slate-400 focus:bg-white/20 focus:outline-none focus:ring-1 focus:ring-white/30 w-40"
        />
      </form>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2 text-slate-300 hover:text-white"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-civic-navy border-t border-white/10 px-4 pb-4">
    {pillars.map((pillar) => (
      <div class="py-2">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">{pillar.label}</p>
        {pillar.items.map((item) => (
          <a href={item.href} class="block py-1.5 text-sm text-slate-300 hover:text-white">
            {item.label}
          </a>
        ))}
      </div>
    ))}
    <form action="/api/search" method="get" class="mt-2">
      <input
        type="search"
        name="q"
        placeholder="Search..."
        class="w-full px-3 py-2 text-sm bg-white/10 border border-white/20 rounded-lg text-white placeholder-slate-400"
      />
    </form>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
