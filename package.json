{
  "name": "govguide",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "import:states": "npx tsx --env-file=.env scripts/import-states.ts",
    "import:counties": "npx tsx --env-file=.env scripts/import-counties.ts",
    "import:cities": "npx tsx --env-file=.env scripts/import-cities.ts",
    "import:zips": "npx tsx --env-file=.env scripts/import-zip-crosswalk.ts",
    "import:geo": "npm run import:states && npm run import:counties && npm run import:cities && npm run import:zips",
    "import:agencies": "npx tsx --env-file=.env scripts/import-agencies.ts",
    "import:congress": "npx tsx --env-file=.env scripts/import-congress-members.ts",
    "import:stock-trades": "npx tsx --env-file=.env scripts/import-stock-trades.ts",
    "import:eos": "npx tsx --env-file=.env scripts/import-executive-orders.ts",
    "import:federal-laws": "npx tsx --env-file=.env scripts/import-federal-law-sources.ts",
    "import:regulations": "npx tsx --env-file=.env scripts/import-regulations.ts",
    "import:federal": "npm run import:agencies && npm run import:congress && npm run import:eos && npm run import:federal-laws && npm run import:regulations",
    "import:fara": "npx tsx --env-file=.env scripts/import-fara.ts",
    "import:predictions": "npx tsx --env-file=.env scripts/import-predictions.ts",
    "import:voteview": "npx tsx --env-file=.env scripts/import-voteview.ts",
    "import:irs990": "npx tsx --env-file=.env scripts/import-irs990.ts",
    "import:tickers": "npx tsx --env-file=.env scripts/import-ticker-metadata.ts",
    "import:statewide-executives": "npx tsx --env-file=.env scripts/import-statewide-executives.ts",
    "import:state-courts": "npx tsx --env-file=.env scripts/import-state-courts.ts",
    "import:courtlistener-judges": "npx tsx --env-file=.env scripts/import-courtlistener-judges.ts",
    "import:littlesis": "npx tsx --env-file=.env scripts/import-littlesis.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "tsx scripts/pipeline/run.ts",
    "pipeline:all": "tsx scripts/pipeline/run.ts --all",
    "pipeline:list": "tsx scripts/pipeline/run.ts --list",
    "detect:predictions": "npx tsx --env-file=.env scripts/detect-prediction-anomalies.ts",
    "detect:conflicts": "npx tsx --env-file=.env scripts/detect-conflicts.ts",
    "detect:all": "npm run detect:conflicts && npm run detect:predictions",
    "import:congress-photos": "npx tsx --env-file=.env scripts/import-congress-photos.ts",
    "pipeline:weekly": "npm run import:congress && npm run import:stock-trades && npm run import:predictions && npm run import:tickers && npm run detect:all"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.4",
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.11",
    "@supabase/supabase-js": "^2.98.0",
    "astro": "^5.17.1",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.33.1",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "maplibre-gl": "^5.19.0",
    "pmtiles": "^4.4.0",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "sigma": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.21.9",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "xlsx": "^0.18.5"
  }
}
