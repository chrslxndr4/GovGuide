{
  "name": "govguide",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "import:states": "npx tsx --env-file=.env scripts/import-states.ts",
    "import:counties": "npx tsx --env-file=.env scripts/import-counties.ts",
    "import:cities": "npx tsx --env-file=.env scripts/import-cities.ts",
    "import:zips": "npx tsx --env-file=.env scripts/import-zip-crosswalk.ts",
    "import:geo": "npm run import:states && npm run import:counties && npm run import:cities && npm run import:zips",
    "import:agencies": "npx tsx --env-file=.env scripts/import-agencies.ts",
    "import:congress": "npx tsx --env-file=.env scripts/import-congress-members.ts",
    "import:eos": "npx tsx --env-file=.env scripts/import-executive-orders.ts",
    "import:federal-laws": "npx tsx --env-file=.env scripts/import-federal-law-sources.ts",
    "import:federal": "npm run import:agencies && npm run import:congress && npm run import:eos && npm run import:federal-laws",
    "import:state-officials": "npx tsx --env-file=.env scripts/import-state-officials.ts",
    "import:election-services": "npx tsx --env-file=.env scripts/import-election-services.ts",
    "import:state-laws": "npx tsx --env-file=.env scripts/import-state-law-sources.ts",
    "import:state": "npm run import:state-officials && npm run import:election-services && npm run import:state-laws",
    "import:all": "npm run import:geo && npm run import:federal && npm run import:state",
    "validate": "npx tsx --env-file=.env scripts/validate-data.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.4",
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@supabase/supabase-js": "^2.98.0",
    "astro": "^5.17.1",
    "maplibre-gl": "^5.19.0",
    "pmtiles": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
